#!/bin/sh
# BofM Reader commit-msg hook
# Detects canon extensions (§7.3 trigger #1 patterns) and blocks commits
# that introduce them without audit evidence in the commit message.
#
# Closes the gap that the regression-baseline pre-commit hook can't:
# new closed-list additions that don't increase any existing rule's
# violation count.
#
# To bypass (Stan-only, explicit decision):
#   git commit --no-verify -m '...'

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

PYTHONIOENCODING=utf-8 python3 validators/check_canon_extensions.py "$1"
