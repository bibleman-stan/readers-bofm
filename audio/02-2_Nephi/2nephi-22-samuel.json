  "lines": [
    {
      "start": 0.0,
      "end": 1.95,
      "type": "line",
      "text": "And in that day thou shalt say:",
      "verse": "22:1",
      "lineIndex": 1
    },
    {
      "start": 2.13,
      "end": 3.152,
      "type": "line",
      "text": "O Lord,",
      "verse": "22:1",
      "lineIndex": 2
    },
    {
      "start": 3.332,
      "end": 4.818,
      "type": "line",
      "text": "I will praise thee;",
      "verse": "22:1",
      "lineIndex": 3
    },
    {
      "start": 4.998,
      "end": 7.181,
      "type": "line",
      "text": "though thou wast angry with me",
      "verse": "22:1",
      "lineIndex": 4
    },
    {
      "start": 7.361,
      "end": 9.033,
      "type": "line",
      "text": "thine anger is turned away,",
      "verse": "22:1",
      "lineIndex": 5
    },
    {
      "start": 9.213,
      "end": 10.885,
      "type": "line",
      "text": "and thou comfortedst me.",
      "verse": "22:1",
      "lineIndex": 6
    },
    {
      "start": 11.565,
      "end": 13.794,
      "type": "line",
      "text": "Behold, God is my salvation;",
      "verse": "22:2",
      "lineIndex": 7
    },
    {
      "start": 13.974,
      "end": 15.228,
      "type": "line",
      "text": "I will trust,",
      "verse": "22:2",
      "lineIndex": 8
    },
    {
      "start": 15.408,
      "end": 16.848,
      "type": "line",
      "text": "and not be afraid;",
      "verse": "22:2",
      "lineIndex": 9
    },
    {
      "start": 17.028,
      "end": 20.697,
      "type": "line",
      "text": "for the Lord Jehovah is my strength and my song;",
      "verse": "22:2",
      "lineIndex": 10
    },
    {
      "start": 20.877,
      "end": 23.06,
      "type": "line",
      "text": "he also has become my salvation.",
      "verse": "22:2",
      "lineIndex": 11
    },
    {
      "start": 23.74,
      "end": 28.756,
      "type": "line",
      "text": "Therefore, with joy shall ye draw water out of the wells of salvation.",
      "verse": "22:3",
      "lineIndex": 12
    },
    {
      "start": 29.436,
      "end": 31.247,
      "type": "line",
      "text": "And in that day shall ye say:",
      "verse": "22:4",
      "lineIndex": 14
    },
    {
      "start": 31.427,
      "end": 32.774,
      "type": "line",
      "text": "Praise the Lord,",
      "verse": "22:4",
      "lineIndex": 15
    },
    {
      "start": 32.954,
      "end": 34.626,
      "type": "line",
      "text": "call upon his name,",
      "verse": "22:4",
      "lineIndex": 16
    },
    {
      "start": 34.806,
      "end": 37.314,
      "type": "line",
      "text": "declare his doings among the people,",
      "verse": "22:4",
      "lineIndex": 17
    },
    {
      "start": 37.494,
      "end": 40.28,
      "type": "line",
      "text": "make mention that his name is exalted.",
      "verse": "22:4",
      "lineIndex": 18
    },
    {
      "start": 40.96,
      "end": 42.4,
      "type": "line",
      "text": "Sing unto the Lord;",
      "verse": "22:5",
      "lineIndex": 19
    },
    {
      "start": 42.58,
      "end": 44.716,
      "type": "line",
      "text": "for he hath done excellent things;",
      "verse": "22:5",
      "lineIndex": 20
    },
    {
      "start": 44.896,
      "end": 47.497,
      "type": "line",
      "text": "this is known in all the earth.",
      "verse": "22:5",
      "lineIndex": 21
    },
    {
      "start": 48.177,
      "end": 49.71,
      "type": "line",
      "text": "Cry out and shout,",
      "verse": "22:6",
      "lineIndex": 22
    },
    {
      "start": 49.89,
      "end": 51.655,
      "type": "line",
      "text": "thou inhabitant of Zion;",
      "verse": "22:6",
      "lineIndex": 23
    },
    {
      "start": 51.835,
      "end": 55.318,
      "type": "line",
      "text": "for great is the Holy One of Israel in the midst of thee.",
      "verse": "22:6",
      "lineIndex": 24
    }
  ]
}