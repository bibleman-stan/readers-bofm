{
  "book": "2nephi",
  "bookName": "2 Nephi",
  "chapter": 27,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 520.464,
  "lines": [
    {
      "start": 0.0,
      "end": 2.415,
      "type": "line",
      "text": "But, behold, in the last days,",
      "verse": "27:1",
      "lineIndex": 1
    },
    {
      "start": 2.595,
      "end": 4.592,
      "type": "line",
      "text": "or in the days of the Gentiles\u2014",
      "verse": "27:1",
      "lineIndex": 2
    },
    {
      "start": 4.772,
      "end": 8.719,
      "type": "line",
      "text": "yea, behold all the nations of the Gentiles and also the Jews,",
      "verse": "27:1",
      "lineIndex": 3
    },
    {
      "start": 8.899,
      "end": 11.5,
      "type": "line",
      "text": "both those who shall come upon this land",
      "verse": "27:1",
      "lineIndex": 4
    },
    {
      "start": 11.68,
      "end": 17.113,
      "type": "line",
      "text": "and those who shall be upon other lands, yea, even upon all the lands of the earth,",
      "verse": "27:1",
      "lineIndex": 5
    },
    {
      "start": 17.293,
      "end": 20.079,
      "type": "line",
      "text": "behold, they will be drunken with iniquity",
      "verse": "27:1",
      "lineIndex": 6
    },
    {
      "start": 20.259,
      "end": 22.767,
      "type": "line",
      "text": "and all manner of abominations\u2014",
      "verse": "27:1",
      "lineIndex": 7
    },
    {
      "start": 23.447,
      "end": 25.119,
      "type": "line",
      "text": "And when that day shall come",
      "verse": "27:2",
      "lineIndex": 8
    },
    {
      "start": 25.299,
      "end": 30.268,
      "type": "line",
      "text": "they shall be visited of the Lord of Hosts, with thunder and with earthquake,",
      "verse": "27:2",
      "lineIndex": 9
    },
    {
      "start": 30.448,
      "end": 32.027,
      "type": "line",
      "text": "and with a great noise,",
      "verse": "27:2",
      "lineIndex": 10
    },
    {
      "start": 32.207,
      "end": 34.808,
      "type": "line",
      "text": "and with storm, and with tempest,",
      "verse": "27:2",
      "lineIndex": 11
    },
    {
      "start": 34.988,
      "end": 37.403,
      "type": "line",
      "text": "and with the flame of devouring fire.",
      "verse": "27:2",
      "lineIndex": 12
    },
    {
      "start": 38.083,
      "end": 40.498,
      "type": "line",
      "text": "And all the nations that fight against Zion,",
      "verse": "27:3",
      "lineIndex": 13
    },
    {
      "start": 40.678,
      "end": 42.35,
      "type": "line",
      "text": "and that distress her,",
      "verse": "27:3",
      "lineIndex": 14
    },
    {
      "start": 42.53,
      "end": 45.27,
      "type": "line",
      "text": "shall be as a dream of a night vision;",
      "verse": "27:3",
      "lineIndex": 15
    },
    {
      "start": 45.45,
      "end": 47.308,
      "type": "line",
      "text": "yea, it shall be unto them,",
      "verse": "27:3",
      "lineIndex": 16
    },
    {
      "start": 47.488,
      "end": 50.089,
      "type": "line",
      "text": "even as unto a hungry man which dreameth,",
      "verse": "27:3",
      "lineIndex": 17
    },
    {
      "start": 50.269,
      "end": 51.941,
      "type": "line",
      "text": "and behold he eateth",
      "verse": "27:3",
      "lineIndex": 18
    },
    {
      "start": 52.121,
      "end": 54.629,
      "type": "line",
      "text": "but he awaketh and his soul is empty;",
      "verse": "27:3",
      "lineIndex": 19
    },
    {
      "start": 54.809,
      "end": 57.735,
      "type": "line",
      "text": "or like unto a thirsty man which dreameth,",
      "verse": "27:3",
      "lineIndex": 20
    },
    {
      "start": 57.915,
      "end": 59.494,
      "type": "line",
      "text": "and behold he drinketh",
      "verse": "27:3",
      "lineIndex": 21
    },
    {
      "start": 59.674,
      "end": 62.368,
      "type": "line",
      "text": "but he awaketh and behold he is faint,",
      "verse": "27:3",
      "lineIndex": 22
    },
    {
      "start": 62.548,
      "end": 64.498,
      "type": "line",
      "text": "and his soul hath appetite;",
      "verse": "27:3",
      "lineIndex": 23
    },
    {
      "start": 64.678,
      "end": 67.186,
      "type": "line",
      "text": "yea, even so shall the multitude",
      "verse": "27:3",
      "lineIndex": 24
    },
    {
      "start": 67.366,
      "end": 70.942,
      "type": "line",
      "text": "of all the nations be that fight against Mount Zion.",
      "verse": "27:3",
      "lineIndex": 25
    },
    {
      "start": 71.622,
      "end": 74.316,
      "type": "line",
      "text": "For behold, all ye that doeth iniquity,",
      "verse": "27:4",
      "lineIndex": 27
    },
    {
      "start": 74.496,
      "end": 76.261,
      "type": "line",
      "text": "stay yourselves and wonder,",
      "verse": "27:4",
      "lineIndex": 28
    },
    {
      "start": 76.441,
      "end": 78.066,
      "type": "line",
      "text": "for ye shall cry out,",
      "verse": "27:4",
      "lineIndex": 29
    },
    {
      "start": 78.246,
      "end": 79.221,
      "type": "line",
      "text": "and cry;",
      "verse": "27:4",
      "lineIndex": 30
    },
    {
      "start": 79.401,
      "end": 81.166,
      "type": "line",
      "text": "yea, ye shall be drunken",
      "verse": "27:4",
      "lineIndex": 31
    },
    {
      "start": 81.346,
      "end": 82.832,
      "type": "line",
      "text": "but not with wine,",
      "verse": "27:4",
      "lineIndex": 32
    },
    {
      "start": 83.012,
      "end": 84.452,
      "type": "line",
      "text": "ye shall stagger",
      "verse": "27:4",
      "lineIndex": 33
    },
    {
      "start": 84.632,
      "end": 86.35,
      "type": "line",
      "text": "but not with strong drink.",
      "verse": "27:4",
      "lineIndex": 34
    },
    {
      "start": 87.03,
      "end": 91.442,
      "type": "line",
      "text": "For behold, the Lord hath poured out upon you the spirit of deep sleep.",
      "verse": "27:5",
      "lineIndex": 35
    },
    {
      "start": 91.622,
      "end": 94.037,
      "type": "line",
      "text": "For behold, ye have closed your eyes,",
      "verse": "27:5",
      "lineIndex": 36
    },
    {
      "start": 94.217,
      "end": 97.607,
      "type": "line",
      "text": "and ye have rejected the prophets; and your rulers,",
      "verse": "27:5",
      "lineIndex": 37
    },
    {
      "start": 97.787,
      "end": 101.131,
      "type": "line",
      "text": "and the seers hath he covered because of your iniquity.",
      "verse": "27:5",
      "lineIndex": 38
    },
    {
      "start": 101.811,
      "end": 103.669,
      "type": "line",
      "text": "And it shall come to pass",
      "verse": "27:6",
      "lineIndex": 39
    },
    {
      "start": 103.849,
      "end": 107.332,
      "type": "line",
      "text": "the Lord God shall bring forth unto you the words of a book,",
      "verse": "27:6",
      "lineIndex": 40
    },
    {
      "start": 107.512,
      "end": 110.577,
      "type": "line",
      "text": "and they shall be the words of them which have slumbered.",
      "verse": "27:6",
      "lineIndex": 41
    },
    {
      "start": 111.257,
      "end": 113.486,
      "type": "line",
      "text": "And behold the book shall be sealed;",
      "verse": "27:7",
      "lineIndex": 42
    },
    {
      "start": 113.666,
      "end": 119.332,
      "type": "line",
      "text": "and in the book shall be a revelation from God, from the beginning of the world to the ending thereof.",
      "verse": "27:7",
      "lineIndex": 43
    },
    {
      "start": 120.012,
      "end": 123.263,
      "type": "line",
      "text": "Wherefore, because of the things which are sealed up,",
      "verse": "27:8",
      "lineIndex": 44
    },
    {
      "start": 123.443,
      "end": 130.827,
      "type": "line",
      "text": "the things which are sealed shall not be delivered in the day of the wickedness and abominations of the people.",
      "verse": "27:8",
      "lineIndex": 45
    },
    {
      "start": 131.007,
      "end": 133.608,
      "type": "line",
      "text": "Wherefore the book shall be kept from them.",
      "verse": "27:8",
      "lineIndex": 46
    },
    {
      "start": 134.288,
      "end": 137.307,
      "type": "line",
      "text": "But the book shall be delivered unto a man,",
      "verse": "27:9",
      "lineIndex": 48
    },
    {
      "start": 137.487,
      "end": 143.431,
      "type": "line",
      "text": "and he shall deliver the words of the book, which are the words of those who have slumbered in the dust,",
      "verse": "27:9",
      "lineIndex": 49
    },
    {
      "start": 143.611,
      "end": 146.351,
      "type": "line",
      "text": "and he shall deliver these words unto another;",
      "verse": "27:9",
      "lineIndex": 50
    },
    {
      "start": 147.031,
      "end": 150.328,
      "type": "line",
      "text": "But the words which are sealed he shall not deliver,",
      "verse": "27:10",
      "lineIndex": 51
    },
    {
      "start": 150.508,
      "end": 152.876,
      "type": "line",
      "text": "neither shall he deliver the book.",
      "verse": "27:10",
      "lineIndex": 52
    },
    {
      "start": 153.056,
      "end": 155.889,
      "type": "line",
      "text": "For the book shall be sealed by the power of God,",
      "verse": "27:10",
      "lineIndex": 53
    },
    {
      "start": 156.069,
      "end": 162.199,
      "type": "line",
      "text": "and the revelation which was sealed shall be kept in the book until the own due time of the Lord,",
      "verse": "27:10",
      "lineIndex": 54
    },
    {
      "start": 162.379,
      "end": 164.051,
      "type": "line",
      "text": "that they may come forth;",
      "verse": "27:10",
      "lineIndex": 55
    },
    {
      "start": 164.231,
      "end": 169.711,
      "type": "line",
      "text": "for behold, they reveal all things from the foundation of the world unto the end thereof.",
      "verse": "27:10",
      "lineIndex": 56
    },
    {
      "start": 170.391,
      "end": 174.106,
      "type": "line",
      "text": "And the day cometh that the words of the book which were sealed",
      "verse": "27:11",
      "lineIndex": 57
    },
    {
      "start": 174.286,
      "end": 176.747,
      "type": "line",
      "text": "shall be read upon the house tops;",
      "verse": "27:11",
      "lineIndex": 58
    },
    {
      "start": 176.927,
      "end": 179.899,
      "type": "line",
      "text": "and they shall be read by the power of Christ;",
      "verse": "27:11",
      "lineIndex": 59
    },
    {
      "start": 180.079,
      "end": 183.608,
      "type": "line",
      "text": "and all things shall be revealed unto the children of men",
      "verse": "27:11",
      "lineIndex": 60
    },
    {
      "start": 183.788,
      "end": 187.317,
      "type": "line",
      "text": "which ever have been among the children of men,",
      "verse": "27:11",
      "lineIndex": 61
    },
    {
      "start": 187.497,
      "end": 190.841,
      "type": "line",
      "text": "and which ever will be even unto the end of the earth.",
      "verse": "27:11",
      "lineIndex": 62
    },
    {
      "start": 191.521,
      "end": 197.93,
      "type": "line",
      "text": "Wherefore, at that day when the book shall be delivered unto the man of whom I have spoken,",
      "verse": "27:12",
      "lineIndex": 63
    },
    {
      "start": 198.11,
      "end": 200.664,
      "type": "line",
      "text": "the book shall be hid from the eyes of the world,",
      "verse": "27:12",
      "lineIndex": 64
    },
    {
      "start": 200.844,
      "end": 203.398,
      "type": "line",
      "text": "that the eyes of none shall behold it",
      "verse": "27:12",
      "lineIndex": 65
    },
    {
      "start": 203.578,
      "end": 207.804,
      "type": "line",
      "text": "save it be that three witnesses shall behold it, by the power of God,",
      "verse": "27:12",
      "lineIndex": 66
    },
    {
      "start": 207.984,
      "end": 210.91,
      "type": "line",
      "text": "besides him to whom the book shall be delivered;",
      "verse": "27:12",
      "lineIndex": 67
    },
    {
      "start": 211.09,
      "end": 216.245,
      "type": "line",
      "text": "and they shall testify to the truth of the book and the things therein.",
      "verse": "27:12",
      "lineIndex": 68
    },
    {
      "start": 216.925,
      "end": 219.479,
      "type": "line",
      "text": "And there is none other which shall view it,",
      "verse": "27:13",
      "lineIndex": 69
    },
    {
      "start": 219.659,
      "end": 222.306,
      "type": "line",
      "text": "save it be a few according to the will of God,",
      "verse": "27:13",
      "lineIndex": 70
    },
    {
      "start": 222.486,
      "end": 226.294,
      "type": "line",
      "text": "to bear testimony of his word unto the children of men;",
      "verse": "27:13",
      "lineIndex": 71
    },
    {
      "start": 226.474,
      "end": 230.886,
      "type": "line",
      "text": "for the Lord God hath said that the words of the faithful should speak",
      "verse": "27:13",
      "lineIndex": 72
    },
    {
      "start": 231.066,
      "end": 232.691,
      "type": "line",
      "text": "as if it were from the dead.",
      "verse": "27:13",
      "lineIndex": 73
    },
    {
      "start": 233.371,
      "end": 238.015,
      "type": "line",
      "text": "Wherefore, the Lord God will proceed to bring forth the words of the book;",
      "verse": "27:14",
      "lineIndex": 74
    },
    {
      "start": 238.195,
      "end": 242.421,
      "type": "line",
      "text": "and in the mouth of as many witnesses as seemeth him good",
      "verse": "27:14",
      "lineIndex": 75
    },
    {
      "start": 242.601,
      "end": 244.412,
      "type": "line",
      "text": "will he establish his word;",
      "verse": "27:14",
      "lineIndex": 76
    },
    {
      "start": 244.592,
      "end": 247.703,
      "type": "line",
      "text": "and wo be unto him that rejecteth the word of God!",
      "verse": "27:14",
      "lineIndex": 77
    },
    {
      "start": 248.383,
      "end": 250.612,
      "type": "line",
      "text": "But behold, it shall come to pass",
      "verse": "27:15",
      "lineIndex": 79
    },
    {
      "start": 250.792,
      "end": 254.879,
      "type": "line",
      "text": "the Lord God shall say unto him to whom he shall deliver the book:",
      "verse": "27:15",
      "lineIndex": 80
    },
    {
      "start": 255.059,
      "end": 257.335,
      "type": "line",
      "text": "Take these words which are not sealed",
      "verse": "27:15",
      "lineIndex": 81
    },
    {
      "start": 257.515,
      "end": 259.605,
      "type": "line",
      "text": "and deliver them to another,",
      "verse": "27:15",
      "lineIndex": 82
    },
    {
      "start": 259.785,
      "end": 262.618,
      "type": "line",
      "text": "that he may show them unto the learned, saying:",
      "verse": "27:15",
      "lineIndex": 83
    },
    {
      "start": 262.798,
      "end": 264.331,
      "type": "line",
      "text": "Read this, I pray thee.",
      "verse": "27:15",
      "lineIndex": 84
    },
    {
      "start": 264.511,
      "end": 266.415,
      "type": "line",
      "text": "And the learned shall say:",
      "verse": "27:15",
      "lineIndex": 85
    },
    {
      "start": 266.595,
      "end": 269.056,
      "type": "line",
      "text": "Bring hither the book, and I will read them.",
      "verse": "27:15",
      "lineIndex": 86
    },
    {
      "start": 269.736,
      "end": 272.615,
      "type": "line",
      "text": "And now, because of the glory of the world",
      "verse": "27:16",
      "lineIndex": 87
    },
    {
      "start": 272.795,
      "end": 274.931,
      "type": "line",
      "text": "and to get gain will they say this,",
      "verse": "27:16",
      "lineIndex": 88
    },
    {
      "start": 275.111,
      "end": 277.247,
      "type": "line",
      "text": "and not for the glory of God.",
      "verse": "27:16",
      "lineIndex": 89
    },
    {
      "start": 277.927,
      "end": 279.692,
      "type": "line",
      "text": "And the man shall say:",
      "verse": "27:17",
      "lineIndex": 90
    },
    {
      "start": 279.872,
      "end": 282.38,
      "type": "line",
      "text": "I cannot bring the book, for it is sealed.",
      "verse": "27:17",
      "lineIndex": 91
    },
    {
      "start": 283.06,
      "end": 284.825,
      "type": "line",
      "text": "Then shall the learned say:",
      "verse": "27:18",
      "lineIndex": 92
    },
    {
      "start": 285.005,
      "end": 286.445,
      "type": "line",
      "text": "I cannot read it.",
      "verse": "27:18",
      "lineIndex": 93
    },
    {
      "start": 287.125,
      "end": 289.122,
      "type": "line",
      "text": "Wherefore it shall come to pass",
      "verse": "27:19",
      "lineIndex": 95
    },
    {
      "start": 289.302,
      "end": 293.064,
      "type": "line",
      "text": "the Lord God will deliver again the book and the words thereof",
      "verse": "27:19",
      "lineIndex": 96
    },
    {
      "start": 293.244,
      "end": 295.241,
      "type": "line",
      "text": "to him that is not learned;",
      "verse": "27:19",
      "lineIndex": 97
    },
    {
      "start": 295.421,
      "end": 298.022,
      "type": "line",
      "text": "and the man that is not learned shall say:",
      "verse": "27:19",
      "lineIndex": 98
    },
    {
      "start": 298.202,
      "end": 299.642,
      "type": "line",
      "text": "I am not learned.",
      "verse": "27:19",
      "lineIndex": 99
    },
    {
      "start": 300.322,
      "end": 302.458,
      "type": "line",
      "text": "Then shall the Lord God say unto him:",
      "verse": "27:20",
      "lineIndex": 100
    },
    {
      "start": 302.638,
      "end": 304.774,
      "type": "line",
      "text": "The learned shall not read them,",
      "verse": "27:20",
      "lineIndex": 101
    },
    {
      "start": 304.954,
      "end": 306.812,
      "type": "line",
      "text": "for they have rejected them,",
      "verse": "27:20",
      "lineIndex": 102
    },
    {
      "start": 306.992,
      "end": 309.268,
      "type": "line",
      "text": "and I am able to do mine own work;",
      "verse": "27:20",
      "lineIndex": 103
    },
    {
      "start": 309.448,
      "end": 313.349,
      "type": "line",
      "text": "wherefore thou shalt read the words which I shall give unto thee.",
      "verse": "27:20",
      "lineIndex": 104
    },
    {
      "start": 314.029,
      "end": 316.305,
      "type": "line",
      "text": "Touch not the things which are sealed,",
      "verse": "27:21",
      "lineIndex": 105
    },
    {
      "start": 316.485,
      "end": 319.271,
      "type": "line",
      "text": "for I will bring them forth in mine own due time;",
      "verse": "27:21",
      "lineIndex": 106
    },
    {
      "start": 319.451,
      "end": 322.005,
      "type": "line",
      "text": "for I will show unto the children of men",
      "verse": "27:21",
      "lineIndex": 107
    },
    {
      "start": 322.185,
      "end": 325.111,
      "type": "line",
      "text": "that I am able to do mine own work.",
      "verse": "27:21",
      "lineIndex": 108
    },
    {
      "start": 325.791,
      "end": 330.249,
      "type": "line",
      "text": "Wherefore, when thou hast read the words which I have commanded thee,",
      "verse": "27:22",
      "lineIndex": 109
    },
    {
      "start": 330.429,
      "end": 333.68,
      "type": "line",
      "text": "and obtained the witnesses which I have promised unto thee,",
      "verse": "27:22",
      "lineIndex": 110
    },
    {
      "start": 333.86,
      "end": 336.182,
      "type": "line",
      "text": "then shalt thou seal up the book again,",
      "verse": "27:22",
      "lineIndex": 111
    },
    {
      "start": 336.362,
      "end": 338.08,
      "type": "line",
      "text": "and hide it up unto me,",
      "verse": "27:22",
      "lineIndex": 112
    },
    {
      "start": 338.26,
      "end": 341.65,
      "type": "line",
      "text": "that I may preserve the words which thou hast not read,",
      "verse": "27:22",
      "lineIndex": 113
    },
    {
      "start": 341.83,
      "end": 344.431,
      "type": "line",
      "text": "until I shall see fit in mine own wisdom",
      "verse": "27:22",
      "lineIndex": 114
    },
    {
      "start": 344.611,
      "end": 347.49,
      "type": "line",
      "text": "to reveal all things unto the children of men.",
      "verse": "27:22",
      "lineIndex": 115
    },
    {
      "start": 348.17,
      "end": 349.981,
      "type": "line",
      "text": "For behold, I am God;",
      "verse": "27:23",
      "lineIndex": 117
    },
    {
      "start": 350.161,
      "end": 352.251,
      "type": "line",
      "text": "and I am a God of miracles;",
      "verse": "27:23",
      "lineIndex": 118
    },
    {
      "start": 352.431,
      "end": 354.196,
      "type": "line",
      "text": "and I will show unto the world",
      "verse": "27:23",
      "lineIndex": 119
    },
    {
      "start": 354.376,
      "end": 357.813,
      "type": "line",
      "text": "that I am the same yesterday, today, and forever;",
      "verse": "27:23",
      "lineIndex": 120
    },
    {
      "start": 357.993,
      "end": 360.826,
      "type": "line",
      "text": "and I work not among the children of men",
      "verse": "27:23",
      "lineIndex": 121
    },
    {
      "start": 361.006,
      "end": 363.374,
      "type": "line",
      "text": "save it be according to their faith.",
      "verse": "27:23",
      "lineIndex": 122
    },
    {
      "start": 364.054,
      "end": 367.258,
      "type": "line",
      "text": "And again it shall come to pass that the Lord shall say",
      "verse": "27:24",
      "lineIndex": 123
    },
    {
      "start": 367.438,
      "end": 371.107,
      "type": "line",
      "text": "unto him that shall read the words that shall be delivered him:",
      "verse": "27:24",
      "lineIndex": 124
    },
    {
      "start": 371.787,
      "end": 375.734,
      "type": "line",
      "text": "Forasmuch as this people draw near unto me with their mouth,",
      "verse": "27:25",
      "lineIndex": 126
    },
    {
      "start": 375.914,
      "end": 377.772,
      "type": "line",
      "text": "and with their lips do honor me,",
      "verse": "27:25",
      "lineIndex": 127
    },
    {
      "start": 377.952,
      "end": 380.46,
      "type": "line",
      "text": "but have removed their hearts far from me,",
      "verse": "27:25",
      "lineIndex": 128
    },
    {
      "start": 380.64,
      "end": 384.355,
      "type": "line",
      "text": "and their fear towards me is taught by the precepts of men\u2014",
      "verse": "27:25",
      "lineIndex": 129
    },
    {
      "start": 385.035,
      "end": 389.4,
      "type": "line",
      "text": "Therefore, I will proceed to do a marvelous work among this people,",
      "verse": "27:26",
      "lineIndex": 130
    },
    {
      "start": 389.58,
      "end": 392.227,
      "type": "line",
      "text": "yea, a marvelous work and a wonder,",
      "verse": "27:26",
      "lineIndex": 131
    },
    {
      "start": 392.407,
      "end": 395.658,
      "type": "line",
      "text": "for the wisdom of their wise and learned shall perish,",
      "verse": "27:26",
      "lineIndex": 132
    },
    {
      "start": 395.838,
      "end": 399.275,
      "type": "line",
      "text": "and the understanding of their prudent shall be hid.",
      "verse": "27:26",
      "lineIndex": 133
    },
    {
      "start": 399.955,
      "end": 403.81,
      "type": "line",
      "text": "And wo unto them that seek deep to hide their counsel from the Lord!",
      "verse": "27:27",
      "lineIndex": 134
    },
    {
      "start": 403.99,
      "end": 405.94,
      "type": "line",
      "text": "And their works are in the dark;",
      "verse": "27:27",
      "lineIndex": 135
    },
    {
      "start": 406.12,
      "end": 407.42,
      "type": "line",
      "text": "and they say:",
      "verse": "27:27",
      "lineIndex": 136
    },
    {
      "start": 407.6,
      "end": 408.947,
      "type": "line",
      "text": "Who seeth us,",
      "verse": "27:27",
      "lineIndex": 137
    },
    {
      "start": 409.127,
      "end": 410.613,
      "type": "line",
      "text": "and who knoweth us?",
      "verse": "27:27",
      "lineIndex": 138
    },
    {
      "start": 410.793,
      "end": 412.186,
      "type": "line",
      "text": "And they also say:",
      "verse": "27:27",
      "lineIndex": 139
    },
    {
      "start": 412.366,
      "end": 417.196,
      "type": "line",
      "text": "Surely, your turning of things upside down shall be esteemed as the potter's clay.",
      "verse": "27:27",
      "lineIndex": 140
    },
    {
      "start": 417.376,
      "end": 419.605,
      "type": "line",
      "text": "But behold, I will show unto them,",
      "verse": "27:27",
      "lineIndex": 141
    },
    {
      "start": 419.785,
      "end": 421.41,
      "type": "line",
      "text": "saith the Lord of Hosts,",
      "verse": "27:27",
      "lineIndex": 142
    },
    {
      "start": 421.59,
      "end": 423.215,
      "type": "line",
      "text": "that I know all their works.",
      "verse": "27:27",
      "lineIndex": 143
    },
    {
      "start": 423.395,
      "end": 426.089,
      "type": "line",
      "text": "For shall the work say of him that made it,",
      "verse": "27:27",
      "lineIndex": 144
    },
    {
      "start": 426.269,
      "end": 427.616,
      "type": "line",
      "text": "he made me not?",
      "verse": "27:27",
      "lineIndex": 145
    },
    {
      "start": 427.796,
      "end": 431.14,
      "type": "line",
      "text": "Or shall the thing framed say of him that framed it,",
      "verse": "27:27",
      "lineIndex": 146
    },
    {
      "start": 431.32,
      "end": 432.945,
      "type": "line",
      "text": "he had no understanding?",
      "verse": "27:27",
      "lineIndex": 147
    },
    {
      "start": 433.625,
      "end": 435.947,
      "type": "line",
      "text": "But behold, saith the Lord of Hosts:",
      "verse": "27:28",
      "lineIndex": 148
    },
    {
      "start": 436.127,
      "end": 438.635,
      "type": "line",
      "text": "I will show unto the children of men",
      "verse": "27:28",
      "lineIndex": 149
    },
    {
      "start": 438.815,
      "end": 441.323,
      "type": "line",
      "text": "that it is yet a very little while",
      "verse": "27:28",
      "lineIndex": 150
    },
    {
      "start": 441.503,
      "end": 444.707,
      "type": "line",
      "text": "and Lebanon shall be turned into a fruitful field;",
      "verse": "27:28",
      "lineIndex": 151
    },
    {
      "start": 444.887,
      "end": 448.277,
      "type": "line",
      "text": "and the fruitful field shall be esteemed as a forest.",
      "verse": "27:28",
      "lineIndex": 152
    },
    {
      "start": 448.957,
      "end": 452.347,
      "type": "line",
      "text": "And in that day shall the deaf hear the words of the book,",
      "verse": "27:29",
      "lineIndex": 154
    },
    {
      "start": 452.527,
      "end": 456.056,
      "type": "line",
      "text": "and the eyes of the blind shall see out of obscurity",
      "verse": "27:29",
      "lineIndex": 155
    },
    {
      "start": 456.236,
      "end": 457.861,
      "type": "line",
      "text": "and out of darkness.",
      "verse": "27:29",
      "lineIndex": 156
    },
    {
      "start": 458.541,
      "end": 460.863,
      "type": "line",
      "text": "And the meek also shall increase,",
      "verse": "27:30",
      "lineIndex": 157
    },
    {
      "start": 461.043,
      "end": 463.272,
      "type": "line",
      "text": "and their joy shall be in the Lord,",
      "verse": "27:30",
      "lineIndex": 158
    },
    {
      "start": 463.452,
      "end": 466.981,
      "type": "line",
      "text": "and the poor among men shall rejoice in the Holy One of Israel.",
      "verse": "27:30",
      "lineIndex": 159
    },
    {
      "start": 467.661,
      "end": 470.169,
      "type": "line",
      "text": "For assuredly as the Lord liveth",
      "verse": "27:31",
      "lineIndex": 160
    },
    {
      "start": 470.349,
      "end": 473.878,
      "type": "line",
      "text": "they shall see that the terrible one is brought to naught,",
      "verse": "27:31",
      "lineIndex": 161
    },
    {
      "start": 474.058,
      "end": 476.148,
      "type": "line",
      "text": "and the scorner is consumed,",
      "verse": "27:31",
      "lineIndex": 162
    },
    {
      "start": 476.328,
      "end": 479.486,
      "type": "line",
      "text": "and all that watch for iniquity are cut off;",
      "verse": "27:31",
      "lineIndex": 163
    },
    {
      "start": 480.166,
      "end": 483.37,
      "type": "line",
      "text": "And they that make a man an offender for a word,",
      "verse": "27:32",
      "lineIndex": 164
    },
    {
      "start": 483.55,
      "end": 486.476,
      "type": "line",
      "text": "and lay a snare for him that reproveth in the gate,",
      "verse": "27:32",
      "lineIndex": 165
    },
    {
      "start": 486.656,
      "end": 489.442,
      "type": "line",
      "text": "and turn aside the just for a thing of naught.",
      "verse": "27:32",
      "lineIndex": 166
    },
    {
      "start": 490.122,
      "end": 493.187,
      "type": "line",
      "text": "Therefore, thus saith the Lord, who redeemed Abraham,",
      "verse": "27:33",
      "lineIndex": 168
    },
    {
      "start": 493.367,
      "end": 495.364,
      "type": "line",
      "text": "concerning the house of Jacob:",
      "verse": "27:33",
      "lineIndex": 169
    },
    {
      "start": 495.544,
      "end": 497.68,
      "type": "line",
      "text": "Jacob shall not now be ashamed,",
      "verse": "27:33",
      "lineIndex": 170
    },
    {
      "start": 497.86,
      "end": 500.182,
      "type": "line",
      "text": "neither shall his face now wax pale.",
      "verse": "27:33",
      "lineIndex": 171
    },
    {
      "start": 500.862,
      "end": 502.72,
      "type": "line",
      "text": "But when he seeth his children,",
      "verse": "27:34",
      "lineIndex": 172
    },
    {
      "start": 502.9,
      "end": 505.501,
      "type": "line",
      "text": "the work of my hands, in the midst of him,",
      "verse": "27:34",
      "lineIndex": 173
    },
    {
      "start": 505.681,
      "end": 507.585,
      "type": "line",
      "text": "they shall sanctify my name,",
      "verse": "27:34",
      "lineIndex": 174
    },
    {
      "start": 507.765,
      "end": 510.087,
      "type": "line",
      "text": "and sanctify the Holy One of Jacob,",
      "verse": "27:34",
      "lineIndex": 175
    },
    {
      "start": 510.267,
      "end": 512.728,
      "type": "line",
      "text": "and shall fear the God of Israel.",
      "verse": "27:34",
      "lineIndex": 176
    },
    {
      "start": 513.408,
      "end": 516.984,
      "type": "line",
      "text": "They also that erred in spirit shall come to understanding,",
      "verse": "27:35",
      "lineIndex": 177
    },
    {
      "start": 517.164,
      "end": 519.811,
      "type": "line",
      "text": "and they that murmured shall learn doctrine.",
      "verse": "27:35",
      "lineIndex": 178
    }
  ]
}