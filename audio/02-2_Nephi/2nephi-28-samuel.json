{
  "book": "2nephi",
  "bookName": "2 Nephi",
  "chapter": 28,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 465.465,
  "lines": [
    {
      "start": 0.0,
      "end": 3.669,
      "type": "line",
      "text": "And now, behold, my brethren, I have spoken unto you,",
      "verse": "28:1",
      "lineIndex": 1
    },
    {
      "start": 3.849,
      "end": 6.496,
      "type": "line",
      "text": "according as the Spirit hath constrained me;",
      "verse": "28:1",
      "lineIndex": 2
    },
    {
      "start": 6.676,
      "end": 10.298,
      "type": "line",
      "text": "wherefore, I know that they must surely come to pass.",
      "verse": "28:1",
      "lineIndex": 3
    },
    {
      "start": 10.978,
      "end": 13.997,
      "type": "line",
      "text": "And the things which shall be written out of the book",
      "verse": "28:2",
      "lineIndex": 4
    },
    {
      "start": 14.177,
      "end": 17.428,
      "type": "line",
      "text": "shall be of great worth unto the children of men,",
      "verse": "28:2",
      "lineIndex": 5
    },
    {
      "start": 17.608,
      "end": 19.744,
      "type": "line",
      "text": "and especially unto our seed,",
      "verse": "28:2",
      "lineIndex": 6
    },
    {
      "start": 19.924,
      "end": 23.082,
      "type": "line",
      "text": "which is a remnant of the house of Israel.",
      "verse": "28:2",
      "lineIndex": 7
    },
    {
      "start": 23.762,
      "end": 26.13,
      "type": "line",
      "text": "For it shall come to pass in that day",
      "verse": "28:3",
      "lineIndex": 9
    },
    {
      "start": 26.31,
      "end": 28.818,
      "type": "line",
      "text": "that the churches which are built up,",
      "verse": "28:3",
      "lineIndex": 10
    },
    {
      "start": 28.998,
      "end": 30.67,
      "type": "line",
      "text": "and not unto the Lord,",
      "verse": "28:3",
      "lineIndex": 11
    },
    {
      "start": 30.85,
      "end": 33.265,
      "type": "line",
      "text": "when the one shall say unto the other:",
      "verse": "28:3",
      "lineIndex": 12
    },
    {
      "start": 33.445,
      "end": 35.674,
      "type": "line",
      "text": "Behold, I, I am the Lord's;",
      "verse": "28:3",
      "lineIndex": 13
    },
    {
      "start": 35.854,
      "end": 37.526,
      "type": "line",
      "text": "and the others shall say:",
      "verse": "28:3",
      "lineIndex": 14
    },
    {
      "start": 37.706,
      "end": 39.053,
      "type": "line",
      "text": "I, I am the Lord's;",
      "verse": "28:3",
      "lineIndex": 15
    },
    {
      "start": 39.233,
      "end": 42.623,
      "type": "line",
      "text": "and thus shall every one say that hath built up churches,",
      "verse": "28:3",
      "lineIndex": 16
    },
    {
      "start": 42.803,
      "end": 44.289,
      "type": "line",
      "text": "and not unto the Lord\u2014",
      "verse": "28:3",
      "lineIndex": 17
    },
    {
      "start": 44.969,
      "end": 47.477,
      "type": "line",
      "text": "And they shall contend one with another;",
      "verse": "28:4",
      "lineIndex": 18
    },
    {
      "start": 47.657,
      "end": 50.954,
      "type": "line",
      "text": "and their priests shall contend one with another,",
      "verse": "28:4",
      "lineIndex": 19
    },
    {
      "start": 51.134,
      "end": 53.688,
      "type": "line",
      "text": "and they shall teach with their learning,",
      "verse": "28:4",
      "lineIndex": 20
    },
    {
      "start": 53.868,
      "end": 56.887,
      "type": "line",
      "text": "and deny the Holy Ghost, which giveth utterance.",
      "verse": "28:4",
      "lineIndex": 21
    },
    {
      "start": 57.567,
      "end": 59.703,
      "type": "line",
      "text": "And they deny the power of God,",
      "verse": "28:5",
      "lineIndex": 22
    },
    {
      "start": 59.883,
      "end": 61.741,
      "type": "line",
      "text": "the Holy One of Israel;",
      "verse": "28:5",
      "lineIndex": 23
    },
    {
      "start": 61.921,
      "end": 63.732,
      "type": "line",
      "text": "and they say unto the people:",
      "verse": "28:5",
      "lineIndex": 24
    },
    {
      "start": 63.912,
      "end": 66.606,
      "type": "line",
      "text": "Hearken unto us, and hear ye our precept;",
      "verse": "28:5",
      "lineIndex": 25
    },
    {
      "start": 66.786,
      "end": 68.829,
      "type": "line",
      "text": "for behold there is no God today,",
      "verse": "28:5",
      "lineIndex": 26
    },
    {
      "start": 69.009,
      "end": 72.074,
      "type": "line",
      "text": "for the Lord and the Redeemer hath done his work,",
      "verse": "28:5",
      "lineIndex": 27
    },
    {
      "start": 72.254,
      "end": 74.53,
      "type": "line",
      "text": "and he hath given his power unto men;",
      "verse": "28:5",
      "lineIndex": 28
    },
    {
      "start": 75.21,
      "end": 77.857,
      "type": "line",
      "text": "Behold, hearken ye unto my precept;",
      "verse": "28:6",
      "lineIndex": 29
    },
    {
      "start": 78.037,
      "end": 82.031,
      "type": "line",
      "text": "if they shall say there is a miracle wrought by the hand of the Lord,",
      "verse": "28:6",
      "lineIndex": 30
    },
    {
      "start": 82.211,
      "end": 83.558,
      "type": "line",
      "text": "believe it not;",
      "verse": "28:6",
      "lineIndex": 31
    },
    {
      "start": 83.738,
      "end": 86.432,
      "type": "line",
      "text": "for this day he is not a God of miracles;",
      "verse": "28:6",
      "lineIndex": 32
    },
    {
      "start": 86.612,
      "end": 88.33,
      "type": "line",
      "text": "he hath done his work.",
      "verse": "28:6",
      "lineIndex": 33
    },
    {
      "start": 89.01,
      "end": 91.796,
      "type": "line",
      "text": "Yea, and there shall be many which shall say:",
      "verse": "28:7",
      "lineIndex": 34
    },
    {
      "start": 91.976,
      "end": 93.926,
      "type": "line",
      "text": "Eat, drink, and be merry,",
      "verse": "28:7",
      "lineIndex": 35
    },
    {
      "start": 94.106,
      "end": 95.639,
      "type": "line",
      "text": "for tomorrow we die;",
      "verse": "28:7",
      "lineIndex": 36
    },
    {
      "start": 95.819,
      "end": 97.769,
      "type": "line",
      "text": "and it shall be well with us.",
      "verse": "28:7",
      "lineIndex": 37
    },
    {
      "start": 98.449,
      "end": 101.096,
      "type": "line",
      "text": "And there shall also be many which shall say:",
      "verse": "28:8",
      "lineIndex": 38
    },
    {
      "start": 101.276,
      "end": 104.805,
      "type": "line",
      "text": "Eat, drink, and be merry; nevertheless, fear God\u2014",
      "verse": "28:8",
      "lineIndex": 39
    },
    {
      "start": 104.985,
      "end": 108.004,
      "type": "line",
      "text": "he will justify in committing a little sin;",
      "verse": "28:8",
      "lineIndex": 40
    },
    {
      "start": 108.184,
      "end": 109.624,
      "type": "line",
      "text": "yea, lie a little,",
      "verse": "28:8",
      "lineIndex": 41
    },
    {
      "start": 109.804,
      "end": 113.194,
      "type": "line",
      "text": "take the advantage of one because of his words,",
      "verse": "28:8",
      "lineIndex": 42
    },
    {
      "start": 113.374,
      "end": 115.232,
      "type": "line",
      "text": "dig a pit for thy neighbor;",
      "verse": "28:8",
      "lineIndex": 43
    },
    {
      "start": 115.412,
      "end": 117.223,
      "type": "line",
      "text": "there is no harm in this;",
      "verse": "28:8",
      "lineIndex": 44
    },
    {
      "start": 117.403,
      "end": 118.982,
      "type": "line",
      "text": "and do all these things,",
      "verse": "28:8",
      "lineIndex": 45
    },
    {
      "start": 119.162,
      "end": 120.695,
      "type": "line",
      "text": "for tomorrow we die;",
      "verse": "28:8",
      "lineIndex": 46
    },
    {
      "start": 120.875,
      "end": 123.011,
      "type": "line",
      "text": "and if it so be that we are guilty,",
      "verse": "28:8",
      "lineIndex": 47
    },
    {
      "start": 123.191,
      "end": 125.467,
      "type": "line",
      "text": "God will beat us with a few stripes,",
      "verse": "28:8",
      "lineIndex": 48
    },
    {
      "start": 125.647,
      "end": 128.666,
      "type": "line",
      "text": "and at last we shall be saved in the kingdom of God.",
      "verse": "28:8",
      "lineIndex": 49
    },
    {
      "start": 129.346,
      "end": 135.569,
      "type": "line",
      "text": "Yea, and there shall be many which shall teach after this manner, false and vain and foolish doctrines,",
      "verse": "28:9",
      "lineIndex": 50
    },
    {
      "start": 135.749,
      "end": 138.21,
      "type": "line",
      "text": "and shall be puffed up in their hearts,",
      "verse": "28:9",
      "lineIndex": 51
    },
    {
      "start": 138.39,
      "end": 141.873,
      "type": "line",
      "text": "and shall seek deep to hide their counsels from the Lord;",
      "verse": "28:9",
      "lineIndex": 52
    },
    {
      "start": 142.053,
      "end": 144.607,
      "type": "line",
      "text": "and their works shall be in the dark.",
      "verse": "28:9",
      "lineIndex": 53
    },
    {
      "start": 145.287,
      "end": 148.909,
      "type": "line",
      "text": "And the blood of the saints shall cry from the ground against them.",
      "verse": "28:10",
      "lineIndex": 54
    },
    {
      "start": 149.589,
      "end": 151.865,
      "type": "line",
      "text": "Yea, they have all gone out of the way;",
      "verse": "28:11",
      "lineIndex": 55
    },
    {
      "start": 152.045,
      "end": 153.624,
      "type": "line",
      "text": "they have become corrupted.",
      "verse": "28:11",
      "lineIndex": 56
    },
    {
      "start": 154.304,
      "end": 155.79,
      "type": "line",
      "text": "Because of pride,",
      "verse": "28:12",
      "lineIndex": 57
    },
    {
      "start": 155.97,
      "end": 159.081,
      "type": "line",
      "text": "and because of false teachers, and false doctrine,",
      "verse": "28:12",
      "lineIndex": 58
    },
    {
      "start": 159.261,
      "end": 161.583,
      "type": "line",
      "text": "their churches have become corrupted,",
      "verse": "28:12",
      "lineIndex": 59
    },
    {
      "start": 161.763,
      "end": 164.085,
      "type": "line",
      "text": "and their churches are lifted up;",
      "verse": "28:12",
      "lineIndex": 60
    },
    {
      "start": 164.265,
      "end": 166.633,
      "type": "line",
      "text": "because of pride they are puffed up.",
      "verse": "28:12",
      "lineIndex": 61
    },
    {
      "start": 167.313,
      "end": 170.239,
      "type": "line",
      "text": "They rob the poor because of their fine sanctuaries;",
      "verse": "28:13",
      "lineIndex": 62
    },
    {
      "start": 170.419,
      "end": 173.298,
      "type": "line",
      "text": "they rob the poor because of their fine clothing;",
      "verse": "28:13",
      "lineIndex": 63
    },
    {
      "start": 173.478,
      "end": 176.729,
      "type": "line",
      "text": "and they persecute the meek and the poor in heart,",
      "verse": "28:13",
      "lineIndex": 64
    },
    {
      "start": 176.909,
      "end": 179.045,
      "type": "line",
      "text": "because in their pride they are puffed up.",
      "verse": "28:13",
      "lineIndex": 65
    },
    {
      "start": 179.725,
      "end": 182.186,
      "type": "line",
      "text": "They wear stiff necks and high heads;",
      "verse": "28:14",
      "lineIndex": 66
    },
    {
      "start": 182.366,
      "end": 185.803,
      "type": "line",
      "text": "yea, and because of pride, and wickedness,",
      "verse": "28:14",
      "lineIndex": 67
    },
    {
      "start": 185.983,
      "end": 188.816,
      "type": "line",
      "text": "and abominations, and whoredoms,",
      "verse": "28:14",
      "lineIndex": 68
    },
    {
      "start": 188.996,
      "end": 190.575,
      "type": "line",
      "text": "they have all gone astray",
      "verse": "28:14",
      "lineIndex": 69
    },
    {
      "start": 190.755,
      "end": 194.563,
      "type": "line",
      "text": "save it be a few, who are the humble followers of Christ;",
      "verse": "28:14",
      "lineIndex": 70
    },
    {
      "start": 194.743,
      "end": 196.786,
      "type": "line",
      "text": "nevertheless, they are led,",
      "verse": "28:14",
      "lineIndex": 71
    },
    {
      "start": 196.966,
      "end": 199.427,
      "type": "line",
      "text": "that in many instances they do err",
      "verse": "28:14",
      "lineIndex": 72
    },
    {
      "start": 199.607,
      "end": 202.486,
      "type": "line",
      "text": "because they are taught by the precepts of men.",
      "verse": "28:14",
      "lineIndex": 73
    },
    {
      "start": 203.166,
      "end": 206.045,
      "type": "line",
      "text": "O the wise, and the learned, and the rich,",
      "verse": "28:15",
      "lineIndex": 75
    },
    {
      "start": 206.225,
      "end": 208.872,
      "type": "line",
      "text": "that are puffed up in the pride of their hearts,",
      "verse": "28:15",
      "lineIndex": 76
    },
    {
      "start": 209.052,
      "end": 211.699,
      "type": "line",
      "text": "and all those who preach false doctrines,",
      "verse": "28:15",
      "lineIndex": 77
    },
    {
      "start": 211.879,
      "end": 214.062,
      "type": "line",
      "text": "and all those who commit whoredoms,",
      "verse": "28:15",
      "lineIndex": 78
    },
    {
      "start": 214.242,
      "end": 216.61,
      "type": "line",
      "text": "and pervert the right way of the Lord,",
      "verse": "28:15",
      "lineIndex": 79
    },
    {
      "start": 216.79,
      "end": 218.787,
      "type": "line",
      "text": "wo, wo, wo be unto them,",
      "verse": "28:15",
      "lineIndex": 80
    },
    {
      "start": 218.967,
      "end": 220.871,
      "type": "line",
      "text": "saith the Lord God Almighty,",
      "verse": "28:15",
      "lineIndex": 81
    },
    {
      "start": 221.051,
      "end": 223.141,
      "type": "line",
      "text": "for they shall be thrust down to hell!",
      "verse": "28:15",
      "lineIndex": 82
    },
    {
      "start": 223.821,
      "end": 227.304,
      "type": "line",
      "text": "Wo unto them that turn aside the just for a thing of naught",
      "verse": "28:16",
      "lineIndex": 83
    },
    {
      "start": 227.484,
      "end": 230.178,
      "type": "line",
      "text": "and revile against that which is good,",
      "verse": "28:16",
      "lineIndex": 84
    },
    {
      "start": 230.358,
      "end": 232.308,
      "type": "line",
      "text": "and say that it is of no worth!",
      "verse": "28:16",
      "lineIndex": 85
    },
    {
      "start": 232.488,
      "end": 233.928,
      "type": "line",
      "text": "For the day shall come",
      "verse": "28:16",
      "lineIndex": 86
    },
    {
      "start": 234.108,
      "end": 238.148,
      "type": "line",
      "text": "that the Lord God will speedily visit the inhabitants of the earth;",
      "verse": "28:16",
      "lineIndex": 87
    },
    {
      "start": 238.328,
      "end": 241.765,
      "type": "line",
      "text": "and in that day that they are fully ripe in iniquity",
      "verse": "28:16",
      "lineIndex": 88
    },
    {
      "start": 241.945,
      "end": 243.478,
      "type": "line",
      "text": "they shall perish.",
      "verse": "28:16",
      "lineIndex": 89
    },
    {
      "start": 244.158,
      "end": 250.009,
      "type": "line",
      "text": "But behold, if the inhabitants of the earth shall repent of their wickedness and abominations",
      "verse": "28:17",
      "lineIndex": 90
    },
    {
      "start": 250.189,
      "end": 252.047,
      "type": "line",
      "text": "they shall not be destroyed,",
      "verse": "28:17",
      "lineIndex": 91
    },
    {
      "start": 252.227,
      "end": 253.992,
      "type": "line",
      "text": "saith the Lord of Hosts.",
      "verse": "28:17",
      "lineIndex": 92
    },
    {
      "start": 254.672,
      "end": 257.876,
      "type": "line",
      "text": "But behold, that great and abominable church,",
      "verse": "28:18",
      "lineIndex": 93
    },
    {
      "start": 258.056,
      "end": 260.239,
      "type": "line",
      "text": "the whore of all the earth,",
      "verse": "28:18",
      "lineIndex": 94
    },
    {
      "start": 260.419,
      "end": 262.091,
      "type": "line",
      "text": "must tumble to the earth,",
      "verse": "28:18",
      "lineIndex": 95
    },
    {
      "start": 262.271,
      "end": 264.221,
      "type": "line",
      "text": "and great must be the fall thereof.",
      "verse": "28:18",
      "lineIndex": 96
    },
    {
      "start": 264.901,
      "end": 267.223,
      "type": "line",
      "text": "For the kingdom of the devil must shake,",
      "verse": "28:19",
      "lineIndex": 97
    },
    {
      "start": 267.403,
      "end": 271.629,
      "type": "line",
      "text": "and they which belong to it must needs be stirred up unto repentance,",
      "verse": "28:19",
      "lineIndex": 98
    },
    {
      "start": 271.809,
      "end": 275.338,
      "type": "line",
      "text": "or the devil will grasp them with his everlasting chains,",
      "verse": "28:19",
      "lineIndex": 99
    },
    {
      "start": 275.518,
      "end": 278.397,
      "type": "line",
      "text": "and they be stirred up to anger, and perish;",
      "verse": "28:19",
      "lineIndex": 100
    },
    {
      "start": 279.077,
      "end": 284.093,
      "type": "line",
      "text": "For behold, at that day shall he rage in the hearts of the children of men,",
      "verse": "28:20",
      "lineIndex": 101
    },
    {
      "start": 284.273,
      "end": 287.756,
      "type": "line",
      "text": "and stir them up to anger against that which is good.",
      "verse": "28:20",
      "lineIndex": 102
    },
    {
      "start": 288.436,
      "end": 290.294,
      "type": "line",
      "text": "And others will he pacify,",
      "verse": "28:21",
      "lineIndex": 103
    },
    {
      "start": 290.474,
      "end": 293.26,
      "type": "line",
      "text": "and lull them away into carnal security,",
      "verse": "28:21",
      "lineIndex": 104
    },
    {
      "start": 293.44,
      "end": 294.88,
      "type": "line",
      "text": "that they will say:",
      "verse": "28:21",
      "lineIndex": 105
    },
    {
      "start": 295.06,
      "end": 296.732,
      "type": "line",
      "text": "All is well in Zion;",
      "verse": "28:21",
      "lineIndex": 106
    },
    {
      "start": 296.912,
      "end": 298.491,
      "type": "line",
      "text": "yea, Zion prospereth,",
      "verse": "28:21",
      "lineIndex": 107
    },
    {
      "start": 298.671,
      "end": 299.925,
      "type": "line",
      "text": "all is well\u2014",
      "verse": "28:21",
      "lineIndex": 108
    },
    {
      "start": 300.105,
      "end": 302.752,
      "type": "line",
      "text": "and thus the devil cheateth their souls,",
      "verse": "28:21",
      "lineIndex": 109
    },
    {
      "start": 302.932,
      "end": 305.486,
      "type": "line",
      "text": "and leadeth them away carefully down to hell.",
      "verse": "28:21",
      "lineIndex": 110
    },
    {
      "start": 306.166,
      "end": 308.581,
      "type": "line",
      "text": "And behold, others he flattereth away,",
      "verse": "28:22",
      "lineIndex": 111
    },
    {
      "start": 308.761,
      "end": 311.083,
      "type": "line",
      "text": "and telleth them there is no hell;",
      "verse": "28:22",
      "lineIndex": 112
    },
    {
      "start": 311.263,
      "end": 312.796,
      "type": "line",
      "text": "and he saith unto them:",
      "verse": "28:22",
      "lineIndex": 113
    },
    {
      "start": 312.976,
      "end": 314.276,
      "type": "line",
      "text": "I am no devil,",
      "verse": "28:22",
      "lineIndex": 114
    },
    {
      "start": 314.456,
      "end": 315.989,
      "type": "line",
      "text": "for there is none\u2014",
      "verse": "28:22",
      "lineIndex": 115
    },
    {
      "start": 316.169,
      "end": 318.352,
      "type": "line",
      "text": "and thus he whispereth in their ears,",
      "verse": "28:22",
      "lineIndex": 116
    },
    {
      "start": 318.532,
      "end": 321.318,
      "type": "line",
      "text": "until he grasps them with his awful chains,",
      "verse": "28:22",
      "lineIndex": 117
    },
    {
      "start": 321.498,
      "end": 323.866,
      "type": "line",
      "text": "from whence there is no deliverance.",
      "verse": "28:22",
      "lineIndex": 118
    },
    {
      "start": 324.546,
      "end": 327.332,
      "type": "line",
      "text": "Yea, they are grasped with death, and hell;",
      "verse": "28:23",
      "lineIndex": 119
    },
    {
      "start": 327.512,
      "end": 332.295,
      "type": "line",
      "text": "and death, and hell, and the devil, and all that have been seized therewith",
      "verse": "28:23",
      "lineIndex": 120
    },
    {
      "start": 332.475,
      "end": 334.797,
      "type": "line",
      "text": "must stand before the throne of God,",
      "verse": "28:23",
      "lineIndex": 121
    },
    {
      "start": 334.977,
      "end": 337.253,
      "type": "line",
      "text": "and be judged according to their works,",
      "verse": "28:23",
      "lineIndex": 122
    },
    {
      "start": 337.433,
      "end": 340.591,
      "type": "line",
      "text": "from whence they must go into the place prepared for them,",
      "verse": "28:23",
      "lineIndex": 123
    },
    {
      "start": 340.771,
      "end": 343.372,
      "type": "line",
      "text": "even a lake of fire and brimstone,",
      "verse": "28:23",
      "lineIndex": 124
    },
    {
      "start": 343.552,
      "end": 345.224,
      "type": "line",
      "text": "which is endless torment.",
      "verse": "28:23",
      "lineIndex": 125
    },
    {
      "start": 345.904,
      "end": 349.294,
      "type": "line",
      "text": "Therefore, wo be unto him that is at ease in Zion!",
      "verse": "28:24",
      "lineIndex": 126
    },
    {
      "start": 349.974,
      "end": 351.924,
      "type": "line",
      "text": "Wo be unto him that crieth:",
      "verse": "28:25",
      "lineIndex": 127
    },
    {
      "start": 352.104,
      "end": 353.311,
      "type": "line",
      "text": "All is well!",
      "verse": "28:25",
      "lineIndex": 128
    },
    {
      "start": 353.991,
      "end": 358.078,
      "type": "line",
      "text": "Yea, wo be unto him that hearkeneth unto the precepts of men,",
      "verse": "28:26",
      "lineIndex": 130
    },
    {
      "start": 358.258,
      "end": 360.301,
      "type": "line",
      "text": "and denieth the power of God,",
      "verse": "28:26",
      "lineIndex": 131
    },
    {
      "start": 360.481,
      "end": 362.617,
      "type": "line",
      "text": "and the gift of the Holy Ghost!",
      "verse": "28:26",
      "lineIndex": 132
    },
    {
      "start": 363.297,
      "end": 365.294,
      "type": "line",
      "text": "Yea, wo be unto him that saith:",
      "verse": "28:27",
      "lineIndex": 133
    },
    {
      "start": 365.474,
      "end": 366.914,
      "type": "line",
      "text": "We have received,",
      "verse": "28:27",
      "lineIndex": 134
    },
    {
      "start": 367.094,
      "end": 368.394,
      "type": "line",
      "text": "and we need no more!",
      "verse": "28:27",
      "lineIndex": 135
    },
    {
      "start": 369.074,
      "end": 371.303,
      "type": "line",
      "text": "And in fine, wo unto all those",
      "verse": "28:28",
      "lineIndex": 136
    },
    {
      "start": 371.483,
      "end": 374.734,
      "type": "line",
      "text": "who tremble, and are angry because of the truth of God!",
      "verse": "28:28",
      "lineIndex": 137
    },
    {
      "start": 374.914,
      "end": 377.422,
      "type": "line",
      "text": "For behold, he that is built upon the rock",
      "verse": "28:28",
      "lineIndex": 138
    },
    {
      "start": 377.602,
      "end": 379.692,
      "type": "line",
      "text": "receiveth it with gladness;",
      "verse": "28:28",
      "lineIndex": 139
    },
    {
      "start": 379.872,
      "end": 383.123,
      "type": "line",
      "text": "and he that is built upon a sandy foundation",
      "verse": "28:28",
      "lineIndex": 140
    },
    {
      "start": 383.303,
      "end": 385.253,
      "type": "line",
      "text": "trembleth lest he shall fall.",
      "verse": "28:28",
      "lineIndex": 141
    },
    {
      "start": 385.933,
      "end": 388.069,
      "type": "line",
      "text": "Wo be unto him that shall say:",
      "verse": "28:29",
      "lineIndex": 142
    },
    {
      "start": 388.249,
      "end": 390.385,
      "type": "line",
      "text": "We have received the word of God,",
      "verse": "28:29",
      "lineIndex": 143
    },
    {
      "start": 390.565,
      "end": 392.701,
      "type": "line",
      "text": "and we need no more of the word of God,",
      "verse": "28:29",
      "lineIndex": 144
    },
    {
      "start": 392.881,
      "end": 394.46,
      "type": "line",
      "text": "for we have enough!",
      "verse": "28:29",
      "lineIndex": 145
    },
    {
      "start": 395.14,
      "end": 397.508,
      "type": "line",
      "text": "For behold, thus saith the Lord God:",
      "verse": "28:30",
      "lineIndex": 146
    },
    {
      "start": 397.688,
      "end": 400.66,
      "type": "line",
      "text": "I will give unto the children of men",
      "verse": "28:30",
      "lineIndex": 147
    },
    {
      "start": 400.84,
      "end": 402.28,
      "type": "line",
      "text": "line upon line,",
      "verse": "28:30",
      "lineIndex": 148
    },
    {
      "start": 402.46,
      "end": 404.178,
      "type": "line",
      "text": "precept upon precept,",
      "verse": "28:30",
      "lineIndex": 149
    },
    {
      "start": 404.358,
      "end": 405.891,
      "type": "line",
      "text": "here a little",
      "verse": "28:30",
      "lineIndex": 150
    },
    {
      "start": 406.071,
      "end": 407.371,
      "type": "line",
      "text": "and there a little;",
      "verse": "28:30",
      "lineIndex": 151
    },
    {
      "start": 407.551,
      "end": 410.802,
      "type": "line",
      "text": "and blessed are those who hearken unto my precepts,",
      "verse": "28:30",
      "lineIndex": 152
    },
    {
      "start": 410.982,
      "end": 413.35,
      "type": "line",
      "text": "and lend an ear unto my counsel,",
      "verse": "28:30",
      "lineIndex": 153
    },
    {
      "start": 413.53,
      "end": 415.48,
      "type": "line",
      "text": "for they shall learn wisdom;",
      "verse": "28:30",
      "lineIndex": 154
    },
    {
      "start": 415.66,
      "end": 417.703,
      "type": "line",
      "text": "for unto him that receiveth",
      "verse": "28:30",
      "lineIndex": 155
    },
    {
      "start": 417.883,
      "end": 419.276,
      "type": "line",
      "text": "I will give more;",
      "verse": "28:30",
      "lineIndex": 156
    },
    {
      "start": 419.456,
      "end": 421.592,
      "type": "line",
      "text": "and from them that shall say,",
      "verse": "28:30",
      "lineIndex": 157
    },
    {
      "start": 421.772,
      "end": 423.072,
      "type": "line",
      "text": "We have enough,",
      "verse": "28:30",
      "lineIndex": 158
    },
    {
      "start": 423.252,
      "end": 425.853,
      "type": "line",
      "text": "from them shall be taken away",
      "verse": "28:30",
      "lineIndex": 159
    },
    {
      "start": 426.033,
      "end": 427.705,
      "type": "line",
      "text": "even that which they have.",
      "verse": "28:30",
      "lineIndex": 160
    },
    {
      "start": 428.385,
      "end": 431.125,
      "type": "line",
      "text": "Cursed is he that putteth his trust in man,",
      "verse": "28:31",
      "lineIndex": 161
    },
    {
      "start": 431.305,
      "end": 433.209,
      "type": "line",
      "text": "or maketh flesh his arm,",
      "verse": "28:31",
      "lineIndex": 162
    },
    {
      "start": 433.389,
      "end": 436.175,
      "type": "line",
      "text": "or shall hearken unto the precepts of men,",
      "verse": "28:31",
      "lineIndex": 163
    },
    {
      "start": 436.355,
      "end": 440.535,
      "type": "line",
      "text": "save their precepts shall be given by the power of the Holy Ghost.",
      "verse": "28:31",
      "lineIndex": 164
    },
    {
      "start": 441.215,
      "end": 442.84,
      "type": "line",
      "text": "Wo be unto the Gentiles,",
      "verse": "28:32",
      "lineIndex": 165
    },
    {
      "start": 443.02,
      "end": 445.017,
      "type": "line",
      "text": "saith the Lord God of Hosts!",
      "verse": "28:32",
      "lineIndex": 166
    },
    {
      "start": 445.197,
      "end": 450.073,
      "type": "line",
      "text": "For notwithstanding I shall lengthen out mine arm unto them from day to day,",
      "verse": "28:32",
      "lineIndex": 167
    },
    {
      "start": 450.253,
      "end": 451.646,
      "type": "line",
      "text": "they will deny me;",
      "verse": "28:32",
      "lineIndex": 168
    },
    {
      "start": 451.826,
      "end": 454.752,
      "type": "line",
      "text": "nevertheless, I will be merciful unto them,",
      "verse": "28:32",
      "lineIndex": 169
    },
    {
      "start": 454.932,
      "end": 456.372,
      "type": "line",
      "text": "saith the Lord God,",
      "verse": "28:32",
      "lineIndex": 170
    },
    {
      "start": 456.552,
      "end": 459.106,
      "type": "line",
      "text": "if they will repent and come unto me;",
      "verse": "28:32",
      "lineIndex": 171
    },
    {
      "start": 459.286,
      "end": 462.63,
      "type": "line",
      "text": "for mine arm is lengthened out all the day long,",
      "verse": "28:32",
      "lineIndex": 172
    },
    {
      "start": 462.81,
      "end": 464.807,
      "type": "line",
      "text": "saith the Lord God of Hosts.",
      "verse": "28:32",
      "lineIndex": 173
    }
  ]
}