{
  "book": "2nephi",
  "bookName": "2 Nephi",
  "chapter": 26,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 556.122,
  "lines": [
    {
      "start": 0.0,
      "end": 2.786,
      "type": "line",
      "text": "And after Christ shall have risen from the dead",
      "verse": "26:1",
      "lineIndex": 1
    },
    {
      "start": 2.966,
      "end": 5.288,
      "type": "line",
      "text": "he shall show himself unto you,",
      "verse": "26:1",
      "lineIndex": 2
    },
    {
      "start": 5.468,
      "end": 8.208,
      "type": "line",
      "text": "my children, and my beloved brethren;",
      "verse": "26:1",
      "lineIndex": 3
    },
    {
      "start": 8.388,
      "end": 10.571,
      "type": "line",
      "text": "and the words which he shall speak",
      "verse": "26:1",
      "lineIndex": 4
    },
    {
      "start": 10.751,
      "end": 13.537,
      "type": "line",
      "text": "unto you shall be the law which ye shall do.",
      "verse": "26:1",
      "lineIndex": 5
    },
    {
      "start": 14.217,
      "end": 16.167,
      "type": "line",
      "text": "For behold, I say unto you",
      "verse": "26:2",
      "lineIndex": 6
    },
    {
      "start": 16.347,
      "end": 19.969,
      "type": "line",
      "text": "that I have beheld that many generations shall pass away,",
      "verse": "26:2",
      "lineIndex": 7
    },
    {
      "start": 20.149,
      "end": 23.771,
      "type": "line",
      "text": "and there shall be great wars and contentions among my people.",
      "verse": "26:2",
      "lineIndex": 8
    },
    {
      "start": 24.451,
      "end": 26.634,
      "type": "line",
      "text": "And after the Messiah shall come",
      "verse": "26:3",
      "lineIndex": 9
    },
    {
      "start": 26.814,
      "end": 30.39,
      "type": "line",
      "text": "there shall be signs given unto my people of his birth,",
      "verse": "26:3",
      "lineIndex": 10
    },
    {
      "start": 30.57,
      "end": 32.753,
      "type": "line",
      "text": "and also of his death and resurrection;",
      "verse": "26:3",
      "lineIndex": 11
    },
    {
      "start": 32.933,
      "end": 36.834,
      "type": "line",
      "text": "and great and terrible shall that day be unto the wicked,",
      "verse": "26:3",
      "lineIndex": 12
    },
    {
      "start": 37.014,
      "end": 38.686,
      "type": "line",
      "text": "for they shall perish;",
      "verse": "26:3",
      "lineIndex": 13
    },
    {
      "start": 38.866,
      "end": 43.464,
      "type": "line",
      "text": "and they perish because they cast out the prophets, and the saints,",
      "verse": "26:3",
      "lineIndex": 14
    },
    {
      "start": 43.644,
      "end": 45.92,
      "type": "line",
      "text": "and stone them, and slay them;",
      "verse": "26:3",
      "lineIndex": 15
    },
    {
      "start": 46.1,
      "end": 48.701,
      "type": "line",
      "text": "wherefore the cry of the blood of the saints",
      "verse": "26:3",
      "lineIndex": 16
    },
    {
      "start": 48.881,
      "end": 51.992,
      "type": "line",
      "text": "shall ascend up to God from the ground against them.",
      "verse": "26:3",
      "lineIndex": 17
    },
    {
      "start": 52.672,
      "end": 54.808,
      "type": "line",
      "text": "Wherefore, all those who are proud,",
      "verse": "26:4",
      "lineIndex": 18
    },
    {
      "start": 54.988,
      "end": 56.567,
      "type": "line",
      "text": "and that do wickedly,",
      "verse": "26:4",
      "lineIndex": 19
    },
    {
      "start": 56.747,
      "end": 59.115,
      "type": "line",
      "text": "the day that cometh shall burn them up,",
      "verse": "26:4",
      "lineIndex": 20
    },
    {
      "start": 59.295,
      "end": 60.92,
      "type": "line",
      "text": "saith the Lord of Hosts,",
      "verse": "26:4",
      "lineIndex": 21
    },
    {
      "start": 61.1,
      "end": 63.05,
      "type": "line",
      "text": "for they shall be as stubble.",
      "verse": "26:4",
      "lineIndex": 22
    },
    {
      "start": 63.73,
      "end": 66.609,
      "type": "line",
      "text": "And they that kill the prophets, and the saints,",
      "verse": "26:5",
      "lineIndex": 24
    },
    {
      "start": 66.789,
      "end": 69.761,
      "type": "line",
      "text": "the depths of the earth shall swallow them up,",
      "verse": "26:5",
      "lineIndex": 25
    },
    {
      "start": 69.941,
      "end": 71.845,
      "type": "line",
      "text": "saith the Lord of Hosts;",
      "verse": "26:5",
      "lineIndex": 26
    },
    {
      "start": 72.025,
      "end": 74.254,
      "type": "line",
      "text": "and mountains shall cover them,",
      "verse": "26:5",
      "lineIndex": 27
    },
    {
      "start": 74.434,
      "end": 76.802,
      "type": "line",
      "text": "and whirlwinds shall carry them away,",
      "verse": "26:5",
      "lineIndex": 28
    },
    {
      "start": 76.982,
      "end": 79.397,
      "type": "line",
      "text": "and buildings shall fall upon them",
      "verse": "26:5",
      "lineIndex": 29
    },
    {
      "start": 79.577,
      "end": 82.178,
      "type": "line",
      "text": "and crush them to pieces and grind them to powder.",
      "verse": "26:5",
      "lineIndex": 30
    },
    {
      "start": 82.858,
      "end": 86.387,
      "type": "line",
      "text": "And they shall be visited with thunderings, and lightnings,",
      "verse": "26:6",
      "lineIndex": 31
    },
    {
      "start": 86.567,
      "end": 89.725,
      "type": "line",
      "text": "and earthquakes, and all manner of destructions,",
      "verse": "26:6",
      "lineIndex": 32
    },
    {
      "start": 89.905,
      "end": 93.899,
      "type": "line",
      "text": "for the fire of the anger of the Lord shall be kindled against them,",
      "verse": "26:6",
      "lineIndex": 33
    },
    {
      "start": 94.079,
      "end": 95.937,
      "type": "line",
      "text": "and they shall be as stubble,",
      "verse": "26:6",
      "lineIndex": 34
    },
    {
      "start": 96.117,
      "end": 98.532,
      "type": "line",
      "text": "and the day that cometh shall consume them,",
      "verse": "26:6",
      "lineIndex": 35
    },
    {
      "start": 98.712,
      "end": 100.477,
      "type": "line",
      "text": "saith the Lord of Hosts.",
      "verse": "26:6",
      "lineIndex": 36
    },
    {
      "start": 101.157,
      "end": 103.851,
      "type": "line",
      "text": "O the pain, and the anguish of my soul",
      "verse": "26:7",
      "lineIndex": 37
    },
    {
      "start": 104.031,
      "end": 106.26,
      "type": "line",
      "text": "for the loss of the slain of my people!",
      "verse": "26:7",
      "lineIndex": 38
    },
    {
      "start": 106.44,
      "end": 108.53,
      "type": "line",
      "text": "For I, Nephi, have seen it,",
      "verse": "26:7",
      "lineIndex": 39
    },
    {
      "start": 108.71,
      "end": 112.379,
      "type": "line",
      "text": "and it well nigh consumeth me before the presence of the Lord;",
      "verse": "26:7",
      "lineIndex": 40
    },
    {
      "start": 112.559,
      "end": 114.417,
      "type": "line",
      "text": "but I must cry unto my God:",
      "verse": "26:7",
      "lineIndex": 41
    },
    {
      "start": 114.597,
      "end": 115.944,
      "type": "line",
      "text": "Thy ways are just.",
      "verse": "26:7",
      "lineIndex": 42
    },
    {
      "start": 116.624,
      "end": 120.525,
      "type": "line",
      "text": "But behold, the righteous that hearken unto the words of the prophets,",
      "verse": "26:8",
      "lineIndex": 43
    },
    {
      "start": 120.705,
      "end": 122.284,
      "type": "line",
      "text": "and destroy them not,",
      "verse": "26:8",
      "lineIndex": 44
    },
    {
      "start": 122.464,
      "end": 124.507,
      "type": "line",
      "text": "but look forward unto Christ",
      "verse": "26:8",
      "lineIndex": 45
    },
    {
      "start": 124.687,
      "end": 128.031,
      "type": "line",
      "text": "with steadfastness for the signs which are given,",
      "verse": "26:8",
      "lineIndex": 46
    },
    {
      "start": 128.211,
      "end": 130.301,
      "type": "line",
      "text": "notwithstanding all persecution\u2014",
      "verse": "26:8",
      "lineIndex": 47
    },
    {
      "start": 130.481,
      "end": 132.942,
      "type": "line",
      "text": "behold, they are they which shall not perish.",
      "verse": "26:8",
      "lineIndex": 48
    },
    {
      "start": 133.622,
      "end": 136.826,
      "type": "line",
      "text": "But the Son of Righteousness shall appear unto them;",
      "verse": "26:9",
      "lineIndex": 49
    },
    {
      "start": 137.006,
      "end": 138.539,
      "type": "line",
      "text": "and he shall heal them,",
      "verse": "26:9",
      "lineIndex": 50
    },
    {
      "start": 138.719,
      "end": 140.716,
      "type": "line",
      "text": "and they shall have peace with him,",
      "verse": "26:9",
      "lineIndex": 51
    },
    {
      "start": 140.896,
      "end": 143.961,
      "type": "line",
      "text": "until three generations shall have passed away,",
      "verse": "26:9",
      "lineIndex": 52
    },
    {
      "start": 144.141,
      "end": 147.856,
      "type": "line",
      "text": "and many of the fourth generation shall have passed away in righteousness.",
      "verse": "26:9",
      "lineIndex": 53
    },
    {
      "start": 148.536,
      "end": 150.951,
      "type": "line",
      "text": "And when these things have passed away",
      "verse": "26:10",
      "lineIndex": 54
    },
    {
      "start": 151.131,
      "end": 153.917,
      "type": "line",
      "text": "a speedy destruction cometh unto my people;",
      "verse": "26:10",
      "lineIndex": 55
    },
    {
      "start": 154.097,
      "end": 156.558,
      "type": "line",
      "text": "for, notwithstanding the pains of my soul,",
      "verse": "26:10",
      "lineIndex": 56
    },
    {
      "start": 156.738,
      "end": 158.224,
      "type": "line",
      "text": "I have seen it;",
      "verse": "26:10",
      "lineIndex": 57
    },
    {
      "start": 158.404,
      "end": 161.469,
      "type": "line",
      "text": "wherefore, I know that it shall come to pass;",
      "verse": "26:10",
      "lineIndex": 58
    },
    {
      "start": 161.649,
      "end": 163.785,
      "type": "line",
      "text": "and they sell themselves for naught;",
      "verse": "26:10",
      "lineIndex": 59
    },
    {
      "start": 163.965,
      "end": 168.005,
      "type": "line",
      "text": "for, for the reward of their pride and their foolishness",
      "verse": "26:10",
      "lineIndex": 60
    },
    {
      "start": 168.185,
      "end": 169.903,
      "type": "line",
      "text": "they shall reap destruction;",
      "verse": "26:10",
      "lineIndex": 61
    },
    {
      "start": 170.083,
      "end": 172.73,
      "type": "line",
      "text": "for because they yield unto the devil",
      "verse": "26:10",
      "lineIndex": 62
    },
    {
      "start": 172.91,
      "end": 175.929,
      "type": "line",
      "text": "and choose works of darkness rather than light,",
      "verse": "26:10",
      "lineIndex": 63
    },
    {
      "start": 176.109,
      "end": 178.292,
      "type": "line",
      "text": "therefore they must go down to hell.",
      "verse": "26:10",
      "lineIndex": 64
    },
    {
      "start": 178.972,
      "end": 182.223,
      "type": "line",
      "text": "For the Spirit of the Lord will not always strive with man.",
      "verse": "26:11",
      "lineIndex": 65
    },
    {
      "start": 182.403,
      "end": 187.79,
      "type": "line",
      "text": "And when the Spirit ceaseth to strive with man then cometh speedy destruction,",
      "verse": "26:11",
      "lineIndex": 66
    },
    {
      "start": 187.97,
      "end": 189.688,
      "type": "line",
      "text": "and this grieveth my soul.",
      "verse": "26:11",
      "lineIndex": 67
    },
    {
      "start": 190.368,
      "end": 195.337,
      "type": "line",
      "text": "And as I spake concerning the convincing of the Jews, that Jesus is the very Christ,",
      "verse": "26:12",
      "lineIndex": 69
    },
    {
      "start": 195.517,
      "end": 198.721,
      "type": "line",
      "text": "it must needs be that the Gentiles be convinced also",
      "verse": "26:12",
      "lineIndex": 70
    },
    {
      "start": 198.901,
      "end": 200.805,
      "type": "line",
      "text": "that Jesus is the Christ,",
      "verse": "26:12",
      "lineIndex": 71
    },
    {
      "start": 200.985,
      "end": 202.425,
      "type": "line",
      "text": "the Eternal God;",
      "verse": "26:12",
      "lineIndex": 72
    },
    {
      "start": 203.105,
      "end": 209.56,
      "type": "line",
      "text": "And that he manifesteth himself unto all those who believe in him, by the power of the Holy Ghost;",
      "verse": "26:13",
      "lineIndex": 73
    },
    {
      "start": 209.74,
      "end": 213.966,
      "type": "line",
      "text": "yea, unto every nation, kindred, tongue, and people,",
      "verse": "26:13",
      "lineIndex": 74
    },
    {
      "start": 214.146,
      "end": 220.973,
      "type": "line",
      "text": "working mighty miracles, signs, and wonders, among the children of men according to their faith.",
      "verse": "26:13",
      "lineIndex": 75
    },
    {
      "start": 221.653,
      "end": 225.554,
      "type": "line",
      "text": "But behold, I prophesy unto you concerning the last days;",
      "verse": "26:14",
      "lineIndex": 76
    },
    {
      "start": 225.734,
      "end": 231.585,
      "type": "line",
      "text": "concerning the days when the Lord God shall bring these things forth unto the children of men.",
      "verse": "26:14",
      "lineIndex": 77
    },
    {
      "start": 232.265,
      "end": 236.955,
      "type": "line",
      "text": "After my seed and the seed of my brethren shall have dwindled in unbelief,",
      "verse": "26:15",
      "lineIndex": 78
    },
    {
      "start": 237.135,
      "end": 239.921,
      "type": "line",
      "text": "and shall have been smitten by the Gentiles;",
      "verse": "26:15",
      "lineIndex": 79
    },
    {
      "start": 240.101,
      "end": 244.281,
      "type": "line",
      "text": "yea, after the Lord God shall have camped against them round about,",
      "verse": "26:15",
      "lineIndex": 80
    },
    {
      "start": 244.461,
      "end": 247.758,
      "type": "line",
      "text": "and shall have laid siege against them with a mount,",
      "verse": "26:15",
      "lineIndex": 81
    },
    {
      "start": 247.938,
      "end": 250.167,
      "type": "line",
      "text": "and raised forts against them;",
      "verse": "26:15",
      "lineIndex": 82
    },
    {
      "start": 250.347,
      "end": 253.551,
      "type": "line",
      "text": "and after they shall have been brought down low in the dust,",
      "verse": "26:15",
      "lineIndex": 83
    },
    {
      "start": 253.731,
      "end": 255.217,
      "type": "line",
      "text": "even that they are not,",
      "verse": "26:15",
      "lineIndex": 84
    },
    {
      "start": 255.397,
      "end": 258.23,
      "type": "line",
      "text": "yet the words of the righteous shall be written,",
      "verse": "26:15",
      "lineIndex": 85
    },
    {
      "start": 258.41,
      "end": 260.964,
      "type": "line",
      "text": "and the prayers of the faithful shall be heard,",
      "verse": "26:15",
      "lineIndex": 86
    },
    {
      "start": 261.144,
      "end": 264.72,
      "type": "line",
      "text": "and all those who have dwindled in unbelief shall not be forgotten.",
      "verse": "26:15",
      "lineIndex": 87
    },
    {
      "start": 265.4,
      "end": 269.765,
      "type": "line",
      "text": "For those who shall be destroyed shall speak unto them out of the ground,",
      "verse": "26:16",
      "lineIndex": 88
    },
    {
      "start": 269.945,
      "end": 272.824,
      "type": "line",
      "text": "and their speech shall be low out of the dust,",
      "verse": "26:16",
      "lineIndex": 89
    },
    {
      "start": 273.004,
      "end": 276.441,
      "type": "line",
      "text": "and their voice shall be as one that hath a familiar spirit;",
      "verse": "26:16",
      "lineIndex": 90
    },
    {
      "start": 276.621,
      "end": 279.222,
      "type": "line",
      "text": "for the Lord God will give unto him power,",
      "verse": "26:16",
      "lineIndex": 91
    },
    {
      "start": 279.402,
      "end": 281.77,
      "type": "line",
      "text": "that he may whisper concerning them,",
      "verse": "26:16",
      "lineIndex": 92
    },
    {
      "start": 281.95,
      "end": 284.458,
      "type": "line",
      "text": "even as it were out of the ground;",
      "verse": "26:16",
      "lineIndex": 93
    },
    {
      "start": 284.638,
      "end": 287.564,
      "type": "line",
      "text": "and their speech shall whisper out of the dust.",
      "verse": "26:16",
      "lineIndex": 94
    },
    {
      "start": 288.244,
      "end": 290.148,
      "type": "line",
      "text": "For thus saith the Lord God:",
      "verse": "26:17",
      "lineIndex": 95
    },
    {
      "start": 290.328,
      "end": 293.439,
      "type": "line",
      "text": "They shall write the things which shall be done among them,",
      "verse": "26:17",
      "lineIndex": 96
    },
    {
      "start": 293.619,
      "end": 296.87,
      "type": "line",
      "text": "and they shall be written and sealed up in a book,",
      "verse": "26:17",
      "lineIndex": 97
    },
    {
      "start": 297.05,
      "end": 300.997,
      "type": "line",
      "text": "and those who have dwindled in unbelief shall not have them,",
      "verse": "26:17",
      "lineIndex": 98
    },
    {
      "start": 301.177,
      "end": 303.638,
      "type": "line",
      "text": "for they seek to destroy the things of God.",
      "verse": "26:17",
      "lineIndex": 99
    },
    {
      "start": 304.318,
      "end": 309.473,
      "type": "line",
      "text": "Wherefore, as those who have been destroyed have been destroyed speedily;",
      "verse": "26:18",
      "lineIndex": 100
    },
    {
      "start": 309.653,
      "end": 314.251,
      "type": "line",
      "text": "and the multitude of their terrible ones shall be as chaff that passeth away\u2014",
      "verse": "26:18",
      "lineIndex": 101
    },
    {
      "start": 314.431,
      "end": 316.567,
      "type": "line",
      "text": "yea, thus saith the Lord God:",
      "verse": "26:18",
      "lineIndex": 102
    },
    {
      "start": 316.747,
      "end": 319.487,
      "type": "line",
      "text": "It shall be at an instant, suddenly\u2014",
      "verse": "26:18",
      "lineIndex": 103
    },
    {
      "start": 320.167,
      "end": 323.929,
      "type": "line",
      "text": "And it shall come to pass, that those who have dwindled in unbelief",
      "verse": "26:19",
      "lineIndex": 104
    },
    {
      "start": 324.109,
      "end": 327.081,
      "type": "line",
      "text": "shall be smitten by the hand of the Gentiles.",
      "verse": "26:19",
      "lineIndex": 105
    },
    {
      "start": 327.761,
      "end": 331.383,
      "type": "line",
      "text": "And the Gentiles are lifted up in the pride of their eyes,",
      "verse": "26:20",
      "lineIndex": 106
    },
    {
      "start": 331.563,
      "end": 336.207,
      "type": "line",
      "text": "and have stumbled, because of the greatness of their stumbling block,",
      "verse": "26:20",
      "lineIndex": 107
    },
    {
      "start": 336.387,
      "end": 339.081,
      "type": "line",
      "text": "that they have built up many churches;",
      "verse": "26:20",
      "lineIndex": 108
    },
    {
      "start": 339.261,
      "end": 342.79,
      "type": "line",
      "text": "nevertheless, they put down the power and miracles of God,",
      "verse": "26:20",
      "lineIndex": 109
    },
    {
      "start": 342.97,
      "end": 351.422,
      "type": "line",
      "text": "and preach up unto themselves their own wisdom and their own learning, that they may get gain and grind upon the face of the poor.",
      "verse": "26:20",
      "lineIndex": 110
    },
    {
      "start": 352.102,
      "end": 356.978,
      "type": "line",
      "text": "And there are many churches built up which cause envyings, and strifes, and malice.",
      "verse": "26:21",
      "lineIndex": 111
    },
    {
      "start": 357.658,
      "end": 360.352,
      "type": "line",
      "text": "And there are also secret combinations,",
      "verse": "26:22",
      "lineIndex": 112
    },
    {
      "start": 360.532,
      "end": 364.572,
      "type": "line",
      "text": "even as in times of old, according to the combinations of the devil,",
      "verse": "26:22",
      "lineIndex": 113
    },
    {
      "start": 364.752,
      "end": 367.306,
      "type": "line",
      "text": "for he is the founder of all these things;",
      "verse": "26:22",
      "lineIndex": 114
    },
    {
      "start": 367.486,
      "end": 370.969,
      "type": "line",
      "text": "yea, the founder of murder, and works of darkness;",
      "verse": "26:22",
      "lineIndex": 115
    },
    {
      "start": 371.149,
      "end": 375.05,
      "type": "line",
      "text": "yea, and he leadeth them by the neck with a flaxen cord,",
      "verse": "26:22",
      "lineIndex": 116
    },
    {
      "start": 375.23,
      "end": 378.806,
      "type": "line",
      "text": "until he bindeth them with his strong cords forever.",
      "verse": "26:22",
      "lineIndex": 117
    },
    {
      "start": 379.486,
      "end": 382.505,
      "type": "line",
      "text": "For behold, my beloved brethren, I say unto you",
      "verse": "26:23",
      "lineIndex": 118
    },
    {
      "start": 382.685,
      "end": 385.379,
      "type": "line",
      "text": "that the Lord God worketh not in darkness.",
      "verse": "26:23",
      "lineIndex": 119
    },
    {
      "start": 386.059,
      "end": 389.821,
      "type": "line",
      "text": "He doeth not anything save it be for the benefit of the world;",
      "verse": "26:24",
      "lineIndex": 121
    },
    {
      "start": 390.001,
      "end": 391.626,
      "type": "line",
      "text": "for he loveth the world,",
      "verse": "26:24",
      "lineIndex": 122
    },
    {
      "start": 391.806,
      "end": 394.082,
      "type": "line",
      "text": "even that he layeth down his own life",
      "verse": "26:24",
      "lineIndex": 123
    },
    {
      "start": 394.262,
      "end": 396.723,
      "type": "line",
      "text": "that he may draw all men unto him.",
      "verse": "26:24",
      "lineIndex": 124
    },
    {
      "start": 396.903,
      "end": 401.919,
      "type": "line",
      "text": "Wherefore, he commandeth none that they shall not partake of his salvation.",
      "verse": "26:24",
      "lineIndex": 125
    },
    {
      "start": 402.599,
      "end": 405.014,
      "type": "line",
      "text": "Behold, doth he cry unto any, saying:",
      "verse": "26:25",
      "lineIndex": 126
    },
    {
      "start": 405.194,
      "end": 406.448,
      "type": "line",
      "text": "Depart from me?",
      "verse": "26:25",
      "lineIndex": 127
    },
    {
      "start": 406.628,
      "end": 408.393,
      "type": "line",
      "text": "Behold, I say unto you, Nay;",
      "verse": "26:25",
      "lineIndex": 128
    },
    {
      "start": 408.573,
      "end": 410.106,
      "type": "line",
      "text": "but he saith:",
      "verse": "26:25",
      "lineIndex": 129
    },
    {
      "start": 410.286,
      "end": 412.933,
      "type": "line",
      "text": "Come unto me all ye ends of the earth,",
      "verse": "26:25",
      "lineIndex": 130
    },
    {
      "start": 413.113,
      "end": 414.599,
      "type": "line",
      "text": "buy milk and honey,",
      "verse": "26:25",
      "lineIndex": 131
    },
    {
      "start": 414.779,
      "end": 417.194,
      "type": "line",
      "text": "without money and without price.",
      "verse": "26:25",
      "lineIndex": 132
    },
    {
      "start": 417.874,
      "end": 422.425,
      "type": "line",
      "text": "Behold, hath he commanded any that they should depart out of the synagogues,",
      "verse": "26:26",
      "lineIndex": 133
    },
    {
      "start": 422.605,
      "end": 424.834,
      "type": "line",
      "text": "or out of the houses of worship?",
      "verse": "26:26",
      "lineIndex": 134
    },
    {
      "start": 425.014,
      "end": 427.057,
      "type": "line",
      "text": "Behold, I say unto you, Nay.",
      "verse": "26:26",
      "lineIndex": 135
    },
    {
      "start": 427.737,
      "end": 432.009,
      "type": "line",
      "text": "Hath he commanded any that they should not partake of his salvation?",
      "verse": "26:27",
      "lineIndex": 136
    },
    {
      "start": 432.189,
      "end": 434.0,
      "type": "line",
      "text": "Behold I say unto you, Nay;",
      "verse": "26:27",
      "lineIndex": 137
    },
    {
      "start": 434.18,
      "end": 436.827,
      "type": "line",
      "text": "but he hath given it free for all men;",
      "verse": "26:27",
      "lineIndex": 138
    },
    {
      "start": 437.007,
      "end": 441.465,
      "type": "line",
      "text": "and he hath commanded his people that they should persuade all men to repentance.",
      "verse": "26:27",
      "lineIndex": 139
    },
    {
      "start": 442.145,
      "end": 446.65,
      "type": "line",
      "text": "Behold, hath the Lord commanded any that they should not partake of his goodness?",
      "verse": "26:28",
      "lineIndex": 140
    },
    {
      "start": 446.83,
      "end": 448.641,
      "type": "line",
      "text": "Behold I say unto you, Nay;",
      "verse": "26:28",
      "lineIndex": 141
    },
    {
      "start": 448.821,
      "end": 452.35,
      "type": "line",
      "text": "but all men are privileged the one like unto the other",
      "verse": "26:28",
      "lineIndex": 142
    },
    {
      "start": 452.53,
      "end": 454.016,
      "type": "line",
      "text": "and none are forbidden.",
      "verse": "26:28",
      "lineIndex": 143
    },
    {
      "start": 454.696,
      "end": 457.854,
      "type": "line",
      "text": "He commandeth that there shall be no priestcrafts;",
      "verse": "26:29",
      "lineIndex": 144
    },
    {
      "start": 458.034,
      "end": 461.192,
      "type": "line",
      "text": "for, behold, priestcrafts are that men preach",
      "verse": "26:29",
      "lineIndex": 145
    },
    {
      "start": 461.372,
      "end": 464.391,
      "type": "line",
      "text": "and set themselves up for a light unto the world,",
      "verse": "26:29",
      "lineIndex": 146
    },
    {
      "start": 464.571,
      "end": 467.543,
      "type": "line",
      "text": "that they may get gain and praise of the world;",
      "verse": "26:29",
      "lineIndex": 147
    },
    {
      "start": 467.723,
      "end": 470.091,
      "type": "line",
      "text": "but they seek not the welfare of Zion.",
      "verse": "26:29",
      "lineIndex": 148
    },
    {
      "start": 470.771,
      "end": 473.186,
      "type": "line",
      "text": "Behold, the Lord hath forbidden this thing;",
      "verse": "26:30",
      "lineIndex": 149
    },
    {
      "start": 473.366,
      "end": 476.942,
      "type": "line",
      "text": "wherefore, the Lord God hath given a commandment",
      "verse": "26:30",
      "lineIndex": 150
    },
    {
      "start": 477.122,
      "end": 479.258,
      "type": "line",
      "text": "that all men should have charity,",
      "verse": "26:30",
      "lineIndex": 151
    },
    {
      "start": 479.438,
      "end": 481.11,
      "type": "line",
      "text": "which charity is love.",
      "verse": "26:30",
      "lineIndex": 152
    },
    {
      "start": 481.29,
      "end": 484.123,
      "type": "line",
      "text": "And except they should have charity they were nothing.",
      "verse": "26:30",
      "lineIndex": 153
    },
    {
      "start": 484.303,
      "end": 486.811,
      "type": "line",
      "text": "Wherefore, if they should have charity",
      "verse": "26:30",
      "lineIndex": 154
    },
    {
      "start": 486.991,
      "end": 490.195,
      "type": "line",
      "text": "they would not suffer the laborer in Zion to perish.",
      "verse": "26:30",
      "lineIndex": 155
    },
    {
      "start": 490.875,
      "end": 494.079,
      "type": "line",
      "text": "But the laborer in Zion shall labor for Zion;",
      "verse": "26:31",
      "lineIndex": 156
    },
    {
      "start": 494.259,
      "end": 496.813,
      "type": "line",
      "text": "for if they labor for money they shall perish.",
      "verse": "26:31",
      "lineIndex": 157
    },
    {
      "start": 497.493,
      "end": 501.255,
      "type": "line",
      "text": "And again, the Lord God hath commanded that men should not murder;",
      "verse": "26:32",
      "lineIndex": 158
    },
    {
      "start": 501.435,
      "end": 503.246,
      "type": "line",
      "text": "that they should not lie;",
      "verse": "26:32",
      "lineIndex": 159
    },
    {
      "start": 503.426,
      "end": 505.051,
      "type": "line",
      "text": "that they should not steal;",
      "verse": "26:32",
      "lineIndex": 160
    },
    {
      "start": 505.231,
      "end": 509.271,
      "type": "line",
      "text": "that they should not take the name of the Lord their God in vain;",
      "verse": "26:32",
      "lineIndex": 161
    },
    {
      "start": 509.451,
      "end": 511.216,
      "type": "line",
      "text": "that they should not envy;",
      "verse": "26:32",
      "lineIndex": 162
    },
    {
      "start": 511.396,
      "end": 513.486,
      "type": "line",
      "text": "that they should not have malice;",
      "verse": "26:32",
      "lineIndex": 163
    },
    {
      "start": 513.666,
      "end": 516.499,
      "type": "line",
      "text": "that they should not contend one with another;",
      "verse": "26:32",
      "lineIndex": 164
    },
    {
      "start": 516.679,
      "end": 518.908,
      "type": "line",
      "text": "that they should not commit whoredoms;",
      "verse": "26:32",
      "lineIndex": 165
    },
    {
      "start": 519.088,
      "end": 521.642,
      "type": "line",
      "text": "and that they should do none of these things;",
      "verse": "26:32",
      "lineIndex": 166
    },
    {
      "start": 521.822,
      "end": 524.283,
      "type": "line",
      "text": "for whoso doeth them shall perish.",
      "verse": "26:32",
      "lineIndex": 167
    },
    {
      "start": 524.963,
      "end": 528.074,
      "type": "line",
      "text": "For none of these iniquities come of the Lord;",
      "verse": "26:33",
      "lineIndex": 168
    },
    {
      "start": 528.254,
      "end": 531.83,
      "type": "line",
      "text": "for he doeth that which is good among the children of men;",
      "verse": "26:33",
      "lineIndex": 169
    },
    {
      "start": 532.01,
      "end": 536.329,
      "type": "line",
      "text": "and he doeth nothing save it be plain unto the children of men;",
      "verse": "26:33",
      "lineIndex": 170
    },
    {
      "start": 536.509,
      "end": 541.571,
      "type": "line",
      "text": "and he inviteth them all to come unto him and partake of his goodness;",
      "verse": "26:33",
      "lineIndex": 171
    },
    {
      "start": 541.751,
      "end": 544.119,
      "type": "line",
      "text": "and he denieth none that come unto him,",
      "verse": "26:33",
      "lineIndex": 172
    },
    {
      "start": 544.299,
      "end": 545.692,
      "type": "line",
      "text": "black and white,",
      "verse": "26:33",
      "lineIndex": 173
    },
    {
      "start": 545.872,
      "end": 547.219,
      "type": "line",
      "text": "bond and free,",
      "verse": "26:33",
      "lineIndex": 174
    },
    {
      "start": 547.399,
      "end": 548.978,
      "type": "line",
      "text": "male and female;",
      "verse": "26:33",
      "lineIndex": 175
    },
    {
      "start": 549.158,
      "end": 551.155,
      "type": "line",
      "text": "and he remembereth the heathen;",
      "verse": "26:33",
      "lineIndex": 176
    },
    {
      "start": 551.335,
      "end": 553.703,
      "type": "line",
      "text": "and all are alike unto God,",
      "verse": "26:33",
      "lineIndex": 177
    },
    {
      "start": 553.883,
      "end": 555.462,
      "type": "line",
      "text": "both Jew and Gentile.",
      "verse": "26:33",
      "lineIndex": 178
    }
  ]
}