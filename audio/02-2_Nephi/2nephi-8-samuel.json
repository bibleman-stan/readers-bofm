{
  "book": "2nephi",
  "bookName": "2 Nephi",
  "chapter": 8,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 305.13,
  "lines": [
    {
      "start": 0.0,
      "end": 1.347,
      "type": "line",
      "text": "Hearken unto me,",
      "verse": "8:1",
      "lineIndex": 1
    },
    {
      "start": 1.527,
      "end": 3.71,
      "type": "line",
      "text": "ye that follow after righteousness.",
      "verse": "8:1",
      "lineIndex": 2
    },
    {
      "start": 3.89,
      "end": 10.252,
      "type": "line",
      "text": "Look unto the rock from whence ye are hewn, and to the hole of the pit from whence ye are digged.",
      "verse": "8:1",
      "lineIndex": 3
    },
    {
      "start": 10.932,
      "end": 15.251,
      "type": "line",
      "text": "Look unto Abraham, your father, and unto Sarah, she that bare you;",
      "verse": "8:2",
      "lineIndex": 4
    },
    {
      "start": 15.431,
      "end": 17.799,
      "type": "line",
      "text": "for I called him alone, and blessed him.",
      "verse": "8:2",
      "lineIndex": 5
    },
    {
      "start": 18.479,
      "end": 20.662,
      "type": "line",
      "text": "For the Lord shall comfort Zion,",
      "verse": "8:3",
      "lineIndex": 6
    },
    {
      "start": 20.842,
      "end": 23.164,
      "type": "line",
      "text": "he will comfort all her waste places;",
      "verse": "8:3",
      "lineIndex": 7
    },
    {
      "start": 23.344,
      "end": 26.13,
      "type": "line",
      "text": "and he will make her wilderness like Eden,",
      "verse": "8:3",
      "lineIndex": 8
    },
    {
      "start": 26.31,
      "end": 28.771,
      "type": "line",
      "text": "and her desert like the garden of the Lord.",
      "verse": "8:3",
      "lineIndex": 9
    },
    {
      "start": 28.951,
      "end": 31.412,
      "type": "line",
      "text": "Joy and gladness shall be found therein,",
      "verse": "8:3",
      "lineIndex": 10
    },
    {
      "start": 31.592,
      "end": 34.146,
      "type": "line",
      "text": "thanksgiving and the voice of melody.",
      "verse": "8:3",
      "lineIndex": 11
    },
    {
      "start": 34.826,
      "end": 36.637,
      "type": "line",
      "text": "Hearken unto me, my people;",
      "verse": "8:4",
      "lineIndex": 13
    },
    {
      "start": 36.817,
      "end": 39.789,
      "type": "line",
      "text": "and give ear unto me, O my nation;",
      "verse": "8:4",
      "lineIndex": 14
    },
    {
      "start": 39.969,
      "end": 42.245,
      "type": "line",
      "text": "for a law shall proceed from me,",
      "verse": "8:4",
      "lineIndex": 15
    },
    {
      "start": 42.425,
      "end": 46.094,
      "type": "line",
      "text": "and I will make my judgment to rest for a light for the people.",
      "verse": "8:4",
      "lineIndex": 16
    },
    {
      "start": 46.774,
      "end": 48.585,
      "type": "line",
      "text": "My righteousness is near;",
      "verse": "8:5",
      "lineIndex": 17
    },
    {
      "start": 48.765,
      "end": 50.669,
      "type": "line",
      "text": "my salvation is gone forth,",
      "verse": "8:5",
      "lineIndex": 18
    },
    {
      "start": 50.849,
      "end": 53.31,
      "type": "line",
      "text": "and mine arm shall judge the people.",
      "verse": "8:5",
      "lineIndex": 19
    },
    {
      "start": 53.49,
      "end": 55.301,
      "type": "line",
      "text": "The isles shall wait upon me,",
      "verse": "8:5",
      "lineIndex": 20
    },
    {
      "start": 55.481,
      "end": 57.757,
      "type": "line",
      "text": "and on mine arm shall they trust.",
      "verse": "8:5",
      "lineIndex": 21
    },
    {
      "start": 58.437,
      "end": 60.666,
      "type": "line",
      "text": "Lift up your eyes to the heavens,",
      "verse": "8:6",
      "lineIndex": 22
    },
    {
      "start": 60.846,
      "end": 62.796,
      "type": "line",
      "text": "and look upon the earth beneath;",
      "verse": "8:6",
      "lineIndex": 23
    },
    {
      "start": 62.976,
      "end": 65.762,
      "type": "line",
      "text": "for the heavens shall vanish away like smoke,",
      "verse": "8:6",
      "lineIndex": 24
    },
    {
      "start": 65.942,
      "end": 68.821,
      "type": "line",
      "text": "and the earth shall wax old like a garment;",
      "verse": "8:6",
      "lineIndex": 25
    },
    {
      "start": 69.001,
      "end": 72.391,
      "type": "line",
      "text": "and they that dwell therein shall die in like manner.",
      "verse": "8:6",
      "lineIndex": 26
    },
    {
      "start": 72.571,
      "end": 74.8,
      "type": "line",
      "text": "But my salvation shall be forever,",
      "verse": "8:6",
      "lineIndex": 27
    },
    {
      "start": 74.98,
      "end": 77.302,
      "type": "line",
      "text": "and my righteousness shall not be abolished.",
      "verse": "8:6",
      "lineIndex": 28
    },
    {
      "start": 77.982,
      "end": 80.861,
      "type": "line",
      "text": "Hearken unto me, ye that know righteousness,",
      "verse": "8:7",
      "lineIndex": 29
    },
    {
      "start": 81.041,
      "end": 83.781,
      "type": "line",
      "text": "the people in whose heart I have written my law,",
      "verse": "8:7",
      "lineIndex": 30
    },
    {
      "start": 83.961,
      "end": 86.422,
      "type": "line",
      "text": "fear ye not the reproach of men,",
      "verse": "8:7",
      "lineIndex": 31
    },
    {
      "start": 86.602,
      "end": 88.924,
      "type": "line",
      "text": "neither be ye afraid of their revilings.",
      "verse": "8:7",
      "lineIndex": 32
    },
    {
      "start": 89.604,
      "end": 92.39,
      "type": "line",
      "text": "For the moth shall eat them up like a garment,",
      "verse": "8:8",
      "lineIndex": 33
    },
    {
      "start": 92.57,
      "end": 94.985,
      "type": "line",
      "text": "and the worm shall eat them like wool.",
      "verse": "8:8",
      "lineIndex": 34
    },
    {
      "start": 95.165,
      "end": 97.626,
      "type": "line",
      "text": "But my righteousness shall be forever,",
      "verse": "8:8",
      "lineIndex": 35
    },
    {
      "start": 97.806,
      "end": 100.825,
      "type": "line",
      "text": "and my salvation from generation to generation.",
      "verse": "8:8",
      "lineIndex": 36
    },
    {
      "start": 101.505,
      "end": 102.759,
      "type": "line",
      "text": "Awake, awake!",
      "verse": "8:9",
      "lineIndex": 38
    },
    {
      "start": 102.939,
      "end": 104.379,
      "type": "line",
      "text": "Put on strength,",
      "verse": "8:9",
      "lineIndex": 39
    },
    {
      "start": 104.559,
      "end": 106.138,
      "type": "line",
      "text": "O arm of the Lord;",
      "verse": "8:9",
      "lineIndex": 40
    },
    {
      "start": 106.318,
      "end": 108.315,
      "type": "line",
      "text": "awake as in the ancient days.",
      "verse": "8:9",
      "lineIndex": 41
    },
    {
      "start": 108.495,
      "end": 111.235,
      "type": "line",
      "text": "Art thou not he that hath cut Rahab,",
      "verse": "8:9",
      "lineIndex": 42
    },
    {
      "start": 111.415,
      "end": 112.948,
      "type": "line",
      "text": "and wounded the dragon?",
      "verse": "8:9",
      "lineIndex": 43
    },
    {
      "start": 113.628,
      "end": 116.647,
      "type": "line",
      "text": "Art thou not he who hath dried the sea,",
      "verse": "8:10",
      "lineIndex": 44
    },
    {
      "start": 116.827,
      "end": 119.103,
      "type": "line",
      "text": "the waters of the great deep;",
      "verse": "8:10",
      "lineIndex": 45
    },
    {
      "start": 119.283,
      "end": 122.023,
      "type": "line",
      "text": "that hath made the depths of the sea a way",
      "verse": "8:10",
      "lineIndex": 46
    },
    {
      "start": 122.203,
      "end": 124.339,
      "type": "line",
      "text": "for the ransomed to pass over?",
      "verse": "8:10",
      "lineIndex": 47
    },
    {
      "start": 125.019,
      "end": 127.759,
      "type": "line",
      "text": "Therefore, the redeemed of the Lord shall return,",
      "verse": "8:11",
      "lineIndex": 48
    },
    {
      "start": 127.939,
      "end": 130.215,
      "type": "line",
      "text": "and come with singing unto Zion;",
      "verse": "8:11",
      "lineIndex": 49
    },
    {
      "start": 130.395,
      "end": 133.878,
      "type": "line",
      "text": "and everlasting joy and holiness shall be upon their heads;",
      "verse": "8:11",
      "lineIndex": 50
    },
    {
      "start": 134.058,
      "end": 136.426,
      "type": "line",
      "text": "and they shall obtain gladness and joy;",
      "verse": "8:11",
      "lineIndex": 51
    },
    {
      "start": 136.606,
      "end": 138.974,
      "type": "line",
      "text": "sorrow and mourning shall flee away.",
      "verse": "8:11",
      "lineIndex": 52
    },
    {
      "start": 139.654,
      "end": 140.722,
      "type": "line",
      "text": "I am he;",
      "verse": "8:12",
      "lineIndex": 53
    },
    {
      "start": 140.902,
      "end": 143.085,
      "type": "line",
      "text": "yea, I am he that comforteth you.",
      "verse": "8:12",
      "lineIndex": 54
    },
    {
      "start": 143.265,
      "end": 144.89,
      "type": "line",
      "text": "Behold, who art thou,",
      "verse": "8:12",
      "lineIndex": 55
    },
    {
      "start": 145.07,
      "end": 148.135,
      "type": "line",
      "text": "that thou shouldst be afraid of man who shall die,",
      "verse": "8:12",
      "lineIndex": 56
    },
    {
      "start": 148.315,
      "end": 151.519,
      "type": "line",
      "text": "and of the son of man who shall be made like unto grass?",
      "verse": "8:12",
      "lineIndex": 57
    },
    {
      "start": 152.199,
      "end": 154.242,
      "type": "line",
      "text": "And forgettest the Lord thy maker,",
      "verse": "8:13",
      "lineIndex": 58
    },
    {
      "start": 154.422,
      "end": 156.93,
      "type": "line",
      "text": "that hath stretched forth the heavens,",
      "verse": "8:13",
      "lineIndex": 59
    },
    {
      "start": 157.11,
      "end": 159.386,
      "type": "line",
      "text": "and laid the foundations of the earth,",
      "verse": "8:13",
      "lineIndex": 60
    },
    {
      "start": 159.566,
      "end": 164.071,
      "type": "line",
      "text": "and hast feared continually every day, because of the fury of the oppressor,",
      "verse": "8:13",
      "lineIndex": 61
    },
    {
      "start": 164.251,
      "end": 166.341,
      "type": "line",
      "text": "as if he were ready to destroy?",
      "verse": "8:13",
      "lineIndex": 62
    },
    {
      "start": 166.521,
      "end": 168.843,
      "type": "line",
      "text": "And where is the fury of the oppressor?",
      "verse": "8:13",
      "lineIndex": 63
    },
    {
      "start": 169.523,
      "end": 172.542,
      "type": "line",
      "text": "The captive exile hasteneth, that he may be loosed,",
      "verse": "8:14",
      "lineIndex": 64
    },
    {
      "start": 172.722,
      "end": 174.998,
      "type": "line",
      "text": "and that he should not die in the pit,",
      "verse": "8:14",
      "lineIndex": 65
    },
    {
      "start": 175.178,
      "end": 177.082,
      "type": "line",
      "text": "nor that his bread should fail.",
      "verse": "8:14",
      "lineIndex": 66
    },
    {
      "start": 177.762,
      "end": 179.62,
      "type": "line",
      "text": "But I am the Lord thy God,",
      "verse": "8:15",
      "lineIndex": 67
    },
    {
      "start": 179.8,
      "end": 181.379,
      "type": "line",
      "text": "whose waves roared;",
      "verse": "8:15",
      "lineIndex": 68
    },
    {
      "start": 181.559,
      "end": 183.509,
      "type": "line",
      "text": "the Lord of Hosts is my name.",
      "verse": "8:15",
      "lineIndex": 69
    },
    {
      "start": 184.189,
      "end": 186.65,
      "type": "line",
      "text": "And I have put my words in thy mouth,",
      "verse": "8:16",
      "lineIndex": 70
    },
    {
      "start": 186.83,
      "end": 189.802,
      "type": "line",
      "text": "and have covered thee in the shadow of mine hand,",
      "verse": "8:16",
      "lineIndex": 71
    },
    {
      "start": 189.982,
      "end": 191.979,
      "type": "line",
      "text": "that I may plant the heavens",
      "verse": "8:16",
      "lineIndex": 72
    },
    {
      "start": 192.159,
      "end": 194.342,
      "type": "line",
      "text": "and lay the foundations of the earth,",
      "verse": "8:16",
      "lineIndex": 73
    },
    {
      "start": 194.522,
      "end": 196.055,
      "type": "line",
      "text": "and say unto Zion:",
      "verse": "8:16",
      "lineIndex": 74
    },
    {
      "start": 196.235,
      "end": 198.093,
      "type": "line",
      "text": "Behold, thou art my people.",
      "verse": "8:16",
      "lineIndex": 75
    },
    {
      "start": 198.773,
      "end": 200.306,
      "type": "line",
      "text": "Awake, awake,",
      "verse": "8:17",
      "lineIndex": 77
    },
    {
      "start": 200.486,
      "end": 201.693,
      "type": "line",
      "text": "stand up,",
      "verse": "8:17",
      "lineIndex": 78
    },
    {
      "start": 201.873,
      "end": 203.034,
      "type": "line",
      "text": "O Jerusalem,",
      "verse": "8:17",
      "lineIndex": 79
    },
    {
      "start": 203.214,
      "end": 206.372,
      "type": "line",
      "text": "which hast drunk at the hand of the Lord the cup of his fury\u2014",
      "verse": "8:17",
      "lineIndex": 80
    },
    {
      "start": 206.552,
      "end": 210.035,
      "type": "line",
      "text": "thou hast drunken the dregs of the cup of trembling wrung out\u2014",
      "verse": "8:17",
      "lineIndex": 81
    },
    {
      "start": 210.715,
      "end": 212.294,
      "type": "line",
      "text": "And none to guide her",
      "verse": "8:18",
      "lineIndex": 82
    },
    {
      "start": 212.474,
      "end": 215.121,
      "type": "line",
      "text": "among all the sons she hath brought forth;",
      "verse": "8:18",
      "lineIndex": 83
    },
    {
      "start": 215.301,
      "end": 217.716,
      "type": "line",
      "text": "neither that taketh her by the hand,",
      "verse": "8:18",
      "lineIndex": 84
    },
    {
      "start": 217.896,
      "end": 220.172,
      "type": "line",
      "text": "of all the sons she hath brought up.",
      "verse": "8:18",
      "lineIndex": 85
    },
    {
      "start": 220.852,
      "end": 223.128,
      "type": "line",
      "text": "These two sons are come unto thee,",
      "verse": "8:19",
      "lineIndex": 86
    },
    {
      "start": 223.308,
      "end": 225.119,
      "type": "line",
      "text": "who shall be sorry for thee\u2014",
      "verse": "8:19",
      "lineIndex": 87
    },
    {
      "start": 225.299,
      "end": 227.667,
      "type": "line",
      "text": "thy desolation and destruction,",
      "verse": "8:19",
      "lineIndex": 88
    },
    {
      "start": 227.847,
      "end": 230.169,
      "type": "line",
      "text": "and the famine and the sword\u2014",
      "verse": "8:19",
      "lineIndex": 89
    },
    {
      "start": 230.349,
      "end": 232.625,
      "type": "line",
      "text": "and by whom shall I comfort thee?",
      "verse": "8:19",
      "lineIndex": 90
    },
    {
      "start": 233.305,
      "end": 235.72,
      "type": "line",
      "text": "Thy sons have fainted, save these two;",
      "verse": "8:20",
      "lineIndex": 91
    },
    {
      "start": 235.9,
      "end": 238.315,
      "type": "line",
      "text": "they lie at the head of all the streets;",
      "verse": "8:20",
      "lineIndex": 92
    },
    {
      "start": 238.495,
      "end": 240.306,
      "type": "line",
      "text": "as a wild bull in a net,",
      "verse": "8:20",
      "lineIndex": 93
    },
    {
      "start": 240.486,
      "end": 242.715,
      "type": "line",
      "text": "they are full of the fury of the Lord,",
      "verse": "8:20",
      "lineIndex": 94
    },
    {
      "start": 242.895,
      "end": 244.613,
      "type": "line",
      "text": "the rebuke of thy God.",
      "verse": "8:20",
      "lineIndex": 95
    },
    {
      "start": 245.293,
      "end": 247.058,
      "type": "line",
      "text": "Therefore hear now this,",
      "verse": "8:21",
      "lineIndex": 96
    },
    {
      "start": 247.238,
      "end": 250.721,
      "type": "line",
      "text": "thou afflicted, and drunken, and not with wine:",
      "verse": "8:21",
      "lineIndex": 97
    },
    {
      "start": 251.401,
      "end": 253.398,
      "type": "line",
      "text": "Thus saith thy Lord, the Lord",
      "verse": "8:22",
      "lineIndex": 98
    },
    {
      "start": 253.578,
      "end": 256.318,
      "type": "line",
      "text": "and thy God pleadeth the cause of his people;",
      "verse": "8:22",
      "lineIndex": 99
    },
    {
      "start": 256.498,
      "end": 260.306,
      "type": "line",
      "text": "behold, I have taken out of thine hand the cup of trembling,",
      "verse": "8:22",
      "lineIndex": 100
    },
    {
      "start": 260.486,
      "end": 262.854,
      "type": "line",
      "text": "the dregs of the cup of my fury;",
      "verse": "8:22",
      "lineIndex": 101
    },
    {
      "start": 263.034,
      "end": 265.031,
      "type": "line",
      "text": "thou shalt no more drink it again.",
      "verse": "8:22",
      "lineIndex": 102
    },
    {
      "start": 265.711,
      "end": 269.287,
      "type": "line",
      "text": "But I will put it into the hand of them that afflict thee;",
      "verse": "8:23",
      "lineIndex": 103
    },
    {
      "start": 269.467,
      "end": 271.0,
      "type": "line",
      "text": "who have said to thy soul:",
      "verse": "8:23",
      "lineIndex": 104
    },
    {
      "start": 271.18,
      "end": 273.316,
      "type": "line",
      "text": "Bow down, that we may go over\u2014",
      "verse": "8:23",
      "lineIndex": 105
    },
    {
      "start": 273.496,
      "end": 275.957,
      "type": "line",
      "text": "and thou hast laid thy body as the ground",
      "verse": "8:23",
      "lineIndex": 106
    },
    {
      "start": 276.137,
      "end": 278.459,
      "type": "line",
      "text": "and as the street to them that went over.",
      "verse": "8:23",
      "lineIndex": 107
    },
    {
      "start": 279.139,
      "end": 280.672,
      "type": "line",
      "text": "Awake, awake,",
      "verse": "8:24",
      "lineIndex": 109
    },
    {
      "start": 280.852,
      "end": 282.431,
      "type": "line",
      "text": "put on thy strength,",
      "verse": "8:24",
      "lineIndex": 110
    },
    {
      "start": 282.611,
      "end": 283.772,
      "type": "line",
      "text": "O Zion;",
      "verse": "8:24",
      "lineIndex": 111
    },
    {
      "start": 283.952,
      "end": 286.042,
      "type": "line",
      "text": "put on thy beautiful garments,",
      "verse": "8:24",
      "lineIndex": 112
    },
    {
      "start": 286.222,
      "end": 288.451,
      "type": "line",
      "text": "O Jerusalem, the holy city;",
      "verse": "8:24",
      "lineIndex": 113
    },
    {
      "start": 288.631,
      "end": 291.417,
      "type": "line",
