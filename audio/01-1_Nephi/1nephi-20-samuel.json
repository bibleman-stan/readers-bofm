{
  "book": "1nephi",
  "bookName": "1 Nephi",
  "chapter": 20,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 258.87,
  "lines": [
    {
      "start": 0.0,
      "end": 1.486,
      "type": "line",
      "text": "Hearken and hear this,",
      "verse": "20:1",
      "lineIndex": 1
    },
    {
      "start": 1.666,
      "end": 3.199,
      "type": "line",
      "text": "O house of Jacob,",
      "verse": "20:1",
      "lineIndex": 2
    },
    {
      "start": 3.379,
      "end": 6.119,
      "type": "line",
      "text": "who are called by the name of Israel,",
      "verse": "20:1",
      "lineIndex": 3
    },
    {
      "start": 6.299,
      "end": 11.407,
      "type": "line",
      "text": "and are come forth out of the waters of Judah, or out of the waters of baptism,",
      "verse": "20:1",
      "lineIndex": 4
    },
    {
      "start": 11.587,
      "end": 13.909,
      "type": "line",
      "text": "who swear by the name of the Lord",
      "verse": "20:1",
      "lineIndex": 5
    },
    {
      "start": 14.089,
      "end": 16.597,
      "type": "line",
      "text": "and make mention of the God of Israel,",
      "verse": "20:1",
      "lineIndex": 6
    },
    {
      "start": 16.777,
      "end": 18.681,
      "type": "line",
      "text": "yet they swear not in truth",
      "verse": "20:1",
      "lineIndex": 7
    },
    {
      "start": 18.861,
      "end": 20.347,
      "type": "line",
      "text": "nor in righteousness.",
      "verse": "20:1",
      "lineIndex": 8
    },
    {
      "start": 21.027,
      "end": 24.324,
      "type": "line",
      "text": "Nevertheless, they call themselves of the holy city,",
      "verse": "20:2",
      "lineIndex": 9
    },
    {
      "start": 24.504,
      "end": 27.755,
      "type": "line",
      "text": "but they do not stay themselves upon the God of Israel,",
      "verse": "20:2",
      "lineIndex": 10
    },
    {
      "start": 27.935,
      "end": 29.746,
      "type": "line",
      "text": "who is the Lord of Hosts;",
      "verse": "20:2",
      "lineIndex": 11
    },
    {
      "start": 29.926,
      "end": 32.248,
      "type": "line",
      "text": "yea, the Lord of Hosts is his name.",
      "verse": "20:2",
      "lineIndex": 12
    },
    {
      "start": 32.928,
      "end": 36.643,
      "type": "line",
      "text": "Behold, I have declared the former things from the beginning;",
      "verse": "20:3",
      "lineIndex": 14
    },
    {
      "start": 36.823,
      "end": 38.82,
      "type": "line",
      "text": "and they went forth out of my mouth,",
      "verse": "20:3",
      "lineIndex": 15
    },
    {
      "start": 39.0,
      "end": 40.718,
      "type": "line",
      "text": "and I showed them.",
      "verse": "20:3",
      "lineIndex": 16
    },
    {
      "start": 40.898,
      "end": 42.477,
      "type": "line",
      "text": "I did show them suddenly.",
      "verse": "20:3",
      "lineIndex": 17
    },
    {
      "start": 43.157,
      "end": 44.643,
      "type": "line",
      "text": "And I did it",
      "verse": "20:4",
      "lineIndex": 18
    },
    {
      "start": 44.823,
      "end": 47.238,
      "type": "line",
      "text": "because I knew that thou art obstinate,",
      "verse": "20:4",
      "lineIndex": 19
    },
    {
      "start": 47.418,
      "end": 51.319,
      "type": "line",
      "text": "and thy neck is an iron sinew, and thy brow brass;",
      "verse": "20:4",
      "lineIndex": 20
    },
    {
      "start": 51.999,
      "end": 54.878,
      "type": "line",
      "text": "And I have even from the beginning declared to thee;",
      "verse": "20:5",
      "lineIndex": 21
    },
    {
      "start": 55.058,
      "end": 58.913,
      "type": "line",
      "text": "before it came to pass I showed them thee; and I showed them",
      "verse": "20:5",
      "lineIndex": 22
    },
    {
      "start": 59.093,
      "end": 61.647,
      "type": "line",
      "text": "for fear lest thou shouldst say\u2014",
      "verse": "20:5",
      "lineIndex": 23
    },
    {
      "start": 61.827,
      "end": 63.638,
      "type": "line",
      "text": "Mine idol hath done them,",
      "verse": "20:5",
      "lineIndex": 24
    },
    {
      "start": 63.818,
      "end": 67.673,
      "type": "line",
      "text": "and my graven image and my molten image hath commanded them.",
      "verse": "20:5",
      "lineIndex": 25
    },
    {
      "start": 68.353,
      "end": 70.721,
      "type": "line",
      "text": "Thou hast seen and heard all this;",
      "verse": "20:6",
      "lineIndex": 27
    },
    {
      "start": 70.901,
      "end": 72.573,
      "type": "line",
      "text": "and will ye not declare them?",
      "verse": "20:6",
      "lineIndex": 28
    },
    {
      "start": 72.753,
      "end": 74.378,
      "type": "line",
      "text": "And that I have showed thee",
      "verse": "20:6",
      "lineIndex": 29
    },
    {
      "start": 74.558,
      "end": 76.23,
      "type": "line",
      "text": "new things from this time,",
      "verse": "20:6",
      "lineIndex": 30
    },
    {
      "start": 76.41,
      "end": 77.943,
      "type": "line",
      "text": "even hidden things,",
      "verse": "20:6",
      "lineIndex": 31
    },
    {
      "start": 78.123,
      "end": 79.841,
      "type": "line",
      "text": "and thou didst not know them.",
      "verse": "20:6",
      "lineIndex": 32
    },
    {
      "start": 80.521,
      "end": 83.54,
      "type": "line",
      "text": "They are created now, and not from the beginning,",
      "verse": "20:7",
      "lineIndex": 33
    },
    {
      "start": 83.72,
      "end": 85.345,
      "type": "line",
      "text": "even before the day",
      "verse": "20:7",
      "lineIndex": 34
    },
    {
      "start": 85.525,
      "end": 89.983,
      "type": "line",
      "text": "when thou heardest them not they were declared unto thee, lest thou shouldst say\u2014",
      "verse": "20:7",
      "lineIndex": 35
    },
    {
      "start": 90.163,
      "end": 91.649,
      "type": "line",
      "text": "Behold I knew them.",
      "verse": "20:7",
      "lineIndex": 36
    },
    {
      "start": 92.329,
      "end": 94.233,
      "type": "line",
      "text": "Yea, and thou heardest not;",
      "verse": "20:8",
      "lineIndex": 37
    },
    {
      "start": 94.413,
      "end": 96.038,
      "type": "line",
      "text": "yea, thou knewest not;",
      "verse": "20:8",
      "lineIndex": 38
    },
    {
      "start": 96.218,
      "end": 99.144,
      "type": "line",
      "text": "yea, from that time thine ear was not opened;",
      "verse": "20:8",
      "lineIndex": 39
    },
    {
      "start": 99.324,
      "end": 102.807,
      "type": "line",
      "text": "for I knew that thou wouldst deal very treacherously,",
      "verse": "20:8",
      "lineIndex": 40
    },
    {
      "start": 102.987,
      "end": 105.681,
      "type": "line",
      "text": "and wast called a transgressor from the womb.",
      "verse": "20:8",
      "lineIndex": 41
    },
    {
      "start": 106.361,
      "end": 109.798,
      "type": "line",
      "text": "Nevertheless, for my name's sake will I defer mine anger,",
      "verse": "20:9",
      "lineIndex": 43
    },
    {
      "start": 109.978,
      "end": 111.464,
      "type": "line",
      "text": "and for my praise",
      "verse": "20:9",
      "lineIndex": 44
    },
    {
      "start": 111.644,
      "end": 114.709,
      "type": "line",
      "text": "will I refrain from thee, that I cut thee not off.",
      "verse": "20:9",
      "lineIndex": 45
    },
    {
      "start": 115.389,
      "end": 116.596,
      "type": "line",
      "text": "For, behold,",
      "verse": "20:10",
      "lineIndex": 46
    },
    {
      "start": 116.776,
      "end": 118.309,
      "type": "line",
      "text": "I have refined thee,",
      "verse": "20:10",
      "lineIndex": 47
    },
    {
      "start": 118.489,
      "end": 121.368,
      "type": "line",
      "text": "I have chosen thee in the furnace of affliction.",
      "verse": "20:10",
      "lineIndex": 48
    },
    {
      "start": 122.048,
      "end": 123.534,
      "type": "line",
      "text": "For mine own sake,",
      "verse": "20:11",
      "lineIndex": 49
    },
    {
      "start": 123.714,
      "end": 126.315,
      "type": "line",
      "text": "yea, for mine own sake will I do this,",
      "verse": "20:11",
      "lineIndex": 50
    },
    {
      "start": 126.495,
      "end": 129.653,
      "type": "line",
      "text": "for I will not suffer my name to be polluted,",
      "verse": "20:11",
      "lineIndex": 51
    },
    {
      "start": 129.833,
      "end": 132.387,
      "type": "line",
      "text": "and I will not give my glory unto another.",
      "verse": "20:11",
      "lineIndex": 52
    },
    {
      "start": 133.067,
      "end": 137.014,
      "type": "line",
      "text": "Hearken unto me, O Jacob, and Israel my called,",
      "verse": "20:12",
      "lineIndex": 54
    },
    {
      "start": 137.194,
      "end": 138.541,
      "type": "line",
      "text": "for I am he;",
      "verse": "20:12",
      "lineIndex": 55
    },
    {
      "start": 138.721,
      "end": 140.857,
      "type": "line",
      "text": "I am the first, and I am also the last.",
      "verse": "20:12",
      "lineIndex": 56
    },
    {
      "start": 141.537,
      "end": 145.159,
      "type": "line",
      "text": "Mine hand hath also laid the foundation of the earth,",
      "verse": "20:13",
      "lineIndex": 57
    },
    {
      "start": 145.339,
      "end": 147.94,
      "type": "line",
      "text": "and my right hand hath spanned the heavens.",
      "verse": "20:13",
      "lineIndex": 58
    },
    {
      "start": 148.12,
      "end": 150.674,
      "type": "line",
      "text": "I call unto them and they stand up together.",
      "verse": "20:13",
      "lineIndex": 59
    },
    {
      "start": 151.354,
      "end": 153.583,
      "type": "line",
      "text": "All ye, assemble yourselves, and hear;",
      "verse": "20:14",
      "lineIndex": 61
    },
    {
      "start": 153.763,
      "end": 157.06,
      "type": "line",
      "text": "who among them hath declared these things unto them?",
      "verse": "20:14",
      "lineIndex": 62
    },
    {
      "start": 157.24,
      "end": 158.819,
      "type": "line",
      "text": "The Lord hath loved him;",
      "verse": "20:14",
      "lineIndex": 63
    },
    {
      "start": 158.999,
      "end": 162.993,
      "type": "line",
      "text": "yea, and he will fulfil his word which he hath declared by them;",
      "verse": "20:14",
      "lineIndex": 64
    },
    {
      "start": 163.173,
      "end": 165.541,
      "type": "line",
      "text": "and he will do his pleasure on Babylon,",
      "verse": "20:14",
      "lineIndex": 65
    },
    {
      "start": 165.721,
      "end": 168.182,
      "type": "line",
      "text": "and his arm shall come upon the Chaldeans.",
      "verse": "20:14",
      "lineIndex": 66
    },
    {
      "start": 168.862,
      "end": 170.487,
      "type": "line",
      "text": "Also, saith the Lord;",
      "verse": "20:15",
      "lineIndex": 67
    },
    {
      "start": 170.667,
      "end": 172.943,
      "type": "line",
      "text": "I the Lord, yea, I have spoken;",
      "verse": "20:15",
      "lineIndex": 68
    },
    {
      "start": 173.123,
      "end": 175.166,
      "type": "line",
      "text": "yea, I have called him to declare,",
      "verse": "20:15",
      "lineIndex": 69
    },
    {
      "start": 175.346,
      "end": 176.879,
      "type": "line",
      "text": "I have brought him,",
      "verse": "20:15",
      "lineIndex": 70
    },
    {
      "start": 177.059,
      "end": 179.474,
      "type": "line",
      "text": "and he shall make his way prosperous.",
      "verse": "20:15",
      "lineIndex": 71
    },
    {
      "start": 180.154,
      "end": 181.733,
      "type": "line",
      "text": "Come ye near unto me;",
      "verse": "20:16",
      "lineIndex": 72
    },
    {
      "start": 181.913,
      "end": 184.792,
      "type": "line",
      "text": "I have not spoken in secret; from the beginning,",
      "verse": "20:16",
      "lineIndex": 73
    },
    {
      "start": 184.972,
      "end": 188.316,
      "type": "line",
      "text": "from the time that it was declared have I spoken;",
      "verse": "20:16",
      "lineIndex": 74
    },
    {
      "start": 188.496,
      "end": 191.84,
      "type": "line",
      "text": "and the Lord God, and his Spirit, hath sent me.",
      "verse": "20:16",
      "lineIndex": 75
    },
    {
      "start": 192.52,
      "end": 196.607,
      "type": "line",
      "text": "And thus saith the Lord, thy Redeemer, the Holy One of Israel;",
      "verse": "20:17",
      "lineIndex": 77
    },
    {
      "start": 196.787,
      "end": 200.502,
      "type": "line",
      "text": "I have sent him, the Lord thy God who teacheth thee to profit,",
      "verse": "20:17",
      "lineIndex": 78
    },
    {
      "start": 200.682,
      "end": 204.629,
      "type": "line",
      "text": "who leadeth thee by the way thou shouldst go, hath done it.",
      "verse": "20:17",
      "lineIndex": 79
    },
    {
      "start": 205.309,
      "end": 208.142,
      "type": "line",
      "text": "O that thou hadst hearkened to my commandments\u2014",
      "verse": "20:18",
      "lineIndex": 80
    },
    {
      "start": 208.322,
      "end": 210.644,
      "type": "line",
      "text": "then had thy peace been as a river,",
      "verse": "20:18",
      "lineIndex": 81
    },
    {
      "start": 210.824,
      "end": 213.889,
      "type": "line",
      "text": "and thy righteousness as the waves of the sea.",
      "verse": "20:18",
      "lineIndex": 82
    },
    {
      "start": 214.569,
      "end": 216.937,
      "type": "line",
      "text": "Thy seed also had been as the sand;",
      "verse": "20:19",
      "lineIndex": 83
    },
    {
      "start": 217.117,
      "end": 219.207,
      "type": "line",
      "text": "the offspring of thy bowels",
      "verse": "20:19",
      "lineIndex": 84
    },
    {
      "start": 219.387,
      "end": 221.059,
      "type": "line",
      "text": "like the gravel thereof;",
      "verse": "20:19",
      "lineIndex": 85
    },
    {
      "start": 221.239,
      "end": 225.326,
      "type": "line",
      "text": "his name should not have been cut off nor destroyed from before me.",
      "verse": "20:19",
      "lineIndex": 86
    },
    {
      "start": 226.006,
      "end": 230.65,
      "type": "line",
      "text": "Go ye forth of Babylon, flee ye from the Chaldeans, with a voice of singing",
      "verse": "20:20",
      "lineIndex": 88
    },
    {
      "start": 230.83,
      "end": 232.409,
      "type": "line",
      "text": "declare ye, tell this,",
      "verse": "20:20",
      "lineIndex": 89
    },
    {
      "start": 232.589,
      "end": 234.632,
      "type": "line",
      "text": "utter to the end of the earth;",
      "verse": "20:20",
      "lineIndex": 90
    },
    {
      "start": 234.812,
      "end": 237.738,
      "type": "line",
      "text": "say ye: The Lord hath redeemed his servant Jacob.",
      "verse": "20:20",
      "lineIndex": 91
    },
    {
      "start": 238.418,
      "end": 240.043,
      "type": "line",
      "text": "And they thirsted not;",
      "verse": "20:21",
      "lineIndex": 92
    },
    {
      "start": 240.223,
      "end": 243.845,
      "type": "line",
      "text": "he led them through the deserts; he caused the waters",
      "verse": "20:21",
      "lineIndex": 93
    },
    {
      "start": 244.025,
      "end": 246.301,
      "type": "line",
      "text": "to flow out of the rock for them;",
      "verse": "20:21",
      "lineIndex": 94
    },
    {
      "start": 246.481,
      "end": 250.196,
      "type": "line",
      "text": "he clave the rock also and the waters gushed out.",
      "verse": "20:21",
      "lineIndex": 95
    },
    {
      "start": 250.876,
      "end": 253.477,
      "type": "line",
      "text": "And notwithstanding he hath done all this,",
      "verse": "20:22",
      "lineIndex": 96
    },
    {
      "start": 253.657,
      "end": 256.025,
      "type": "line",
      "text": "and greater also, there is no peace,",
      "verse": "20:22",
      "lineIndex": 97
    },
    {
      "start": 256.205,
      "end": 258.202,
      "type": "line",
      "text": "saith the Lord, unto the wicked.",
      "verse": "20:22",
      "lineIndex": 98
    }
  ]
}