{
  "book": "1nephi",
  "bookName": "1 Nephi",
  "chapter": 21,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 355.228,
  "lines": [
    {
      "start": 0.0,
      "end": 1.579,
      "type": "line",
      "text": "And again: Hearken,",
      "verse": "21:1",
      "lineIndex": 1
    },
    {
      "start": 1.759,
      "end": 3.431,
      "type": "line",
      "text": "O ye house of Israel,",
      "verse": "21:1",
      "lineIndex": 2
    },
    {
      "start": 3.611,
      "end": 9.602,
      "type": "line",
      "text": "all ye that are broken off and are driven out because of the wickedness of the pastors of my people;",
      "verse": "21:1",
      "lineIndex": 3
    },
    {
      "start": 9.782,
      "end": 11.872,
      "type": "line",
      "text": "yea, all ye that are broken off,",
      "verse": "21:1",
      "lineIndex": 4
    },
    {
      "start": 12.052,
      "end": 15.117,
      "type": "line",
      "text": "that are scattered abroad, who are of my people,",
      "verse": "21:1",
      "lineIndex": 5
    },
    {
      "start": 15.297,
      "end": 16.83,
      "type": "line",
      "text": "O house of Israel.",
      "verse": "21:1",
      "lineIndex": 6
    },
    {
      "start": 17.01,
      "end": 18.821,
      "type": "line",
      "text": "Listen, O isles, unto me,",
      "verse": "21:1",
      "lineIndex": 7
    },
    {
      "start": 19.001,
      "end": 21.137,
      "type": "line",
      "text": "and hearken ye people from far;",
      "verse": "21:1",
      "lineIndex": 8
    },
    {
      "start": 21.317,
      "end": 23.546,
      "type": "line",
      "text": "the Lord hath called me from the womb;",
      "verse": "21:1",
      "lineIndex": 9
    },
    {
      "start": 23.726,
      "end": 26.187,
      "type": "line",
      "text": "from the bowels of my mother",
      "verse": "21:1",
      "lineIndex": 10
    },
    {
      "start": 26.367,
      "end": 28.364,
      "type": "line",
      "text": "hath he made mention of my name.",
      "verse": "21:1",
      "lineIndex": 11
    },
    {
      "start": 29.044,
      "end": 31.923,
      "type": "line",
      "text": "And he hath made my mouth like a sharp sword;",
      "verse": "21:2",
      "lineIndex": 12
    },
    {
      "start": 32.103,
      "end": 33.868,
      "type": "line",
      "text": "in the shadow of his hand",
      "verse": "21:2",
      "lineIndex": 13
    },
    {
      "start": 34.048,
      "end": 37.206,
      "type": "line",
      "text": "hath he hid me, and made me a polished shaft;",
      "verse": "21:2",
      "lineIndex": 14
    },
    {
      "start": 37.386,
      "end": 39.476,
      "type": "line",
      "text": "in his quiver hath he hid me;",
      "verse": "21:2",
      "lineIndex": 15
    },
    {
      "start": 40.156,
      "end": 41.596,
      "type": "line",
      "text": "And said unto me:",
      "verse": "21:3",
      "lineIndex": 16
    },
    {
      "start": 41.776,
      "end": 44.052,
      "type": "line",
      "text": "Thou art my servant, O Israel,",
      "verse": "21:3",
      "lineIndex": 17
    },
    {
      "start": 44.232,
      "end": 45.95,
      "type": "line",
      "text": "in whom I will be glorified.",
      "verse": "21:3",
      "lineIndex": 18
    },
    {
      "start": 46.63,
      "end": 47.93,
      "type": "line",
      "text": "Then I said,",
      "verse": "21:4",
      "lineIndex": 20
    },
    {
      "start": 48.11,
      "end": 49.735,
      "type": "line",
      "text": "I have labored in vain,",
      "verse": "21:4",
      "lineIndex": 21
    },
    {
      "start": 49.915,
      "end": 53.119,
      "type": "line",
      "text": "I have spent my strength for naught and in vain;",
      "verse": "21:4",
      "lineIndex": 22
    },
    {
      "start": 53.299,
      "end": 55.807,
      "type": "line",
      "text": "surely my judgment is with the Lord,",
      "verse": "21:4",
      "lineIndex": 23
    },
    {
      "start": 55.987,
      "end": 57.752,
      "type": "line",
      "text": "and my work with my God.",
      "verse": "21:4",
      "lineIndex": 24
    },
    {
      "start": 58.432,
      "end": 63.773,
      "type": "line",
      "text": "And now, saith the Lord\u2014 that formed me from the womb that I should be his servant,",
      "verse": "21:5",
      "lineIndex": 25
    },
    {
      "start": 63.953,
      "end": 66.136,
      "type": "line",
      "text": "to bring Jacob again to him\u2014",
      "verse": "21:5",
      "lineIndex": 26
    },
    {
      "start": 66.316,
      "end": 68.452,
      "type": "line",
      "text": "though Israel be not gathered,",
      "verse": "21:5",
      "lineIndex": 27
    },
    {
      "start": 68.632,
      "end": 71.558,
      "type": "line",
      "text": "yet shall I be glorious in the eyes of the Lord,",
      "verse": "21:5",
      "lineIndex": 28
    },
    {
      "start": 71.738,
      "end": 73.828,
      "type": "line",
      "text": "and my God shall be my strength.",
      "verse": "21:5",
      "lineIndex": 29
    },
    {
      "start": 74.508,
      "end": 79.059,
      "type": "line",
      "text": "And he said: It is a light thing that thou shouldst be my servant",
      "verse": "21:6",
      "lineIndex": 31
    },
    {
      "start": 79.239,
      "end": 81.375,
      "type": "line",
      "text": "to raise up the tribes of Jacob,",
      "verse": "21:6",
      "lineIndex": 32
    },
    {
      "start": 81.555,
      "end": 83.923,
      "type": "line",
      "text": "and to restore the preserved of Israel.",
      "verse": "21:6",
      "lineIndex": 33
    },
    {
      "start": 84.103,
      "end": 87.261,
      "type": "line",
      "text": "I will also give thee for a light to the Gentiles,",
      "verse": "21:6",
      "lineIndex": 34
    },
    {
      "start": 87.441,
      "end": 91.063,
      "type": "line",
      "text": "that thou mayest be my salvation unto the ends of the earth.",
      "verse": "21:6",
      "lineIndex": 35
    },
    {
      "start": 91.743,
      "end": 93.229,
      "type": "line",
      "text": "Thus saith the Lord,",
      "verse": "21:7",
      "lineIndex": 36
    },
    {
      "start": 93.409,
      "end": 95.87,
      "type": "line",
      "text": "the Redeemer of Israel, his Holy One,",
      "verse": "21:7",
      "lineIndex": 37
    },
    {
      "start": 96.05,
      "end": 98.511,
      "type": "line",
      "text": "to him whom man despiseth,",
      "verse": "21:7",
      "lineIndex": 38
    },
    {
      "start": 98.691,
      "end": 101.106,
      "type": "line",
      "text": "to him whom the nations abhorreth,",
      "verse": "21:7",
      "lineIndex": 39
    },
    {
      "start": 101.286,
      "end": 102.911,
      "type": "line",
      "text": "to servant of rulers:",
      "verse": "21:7",
      "lineIndex": 40
    },
    {
      "start": 103.091,
      "end": 108.989,
      "type": "line",
      "text": "Kings shall see and arise, princes also shall worship, because of the Lord that is faithful.",
      "verse": "21:7",
      "lineIndex": 41
    },
    {
      "start": 109.669,
      "end": 111.202,
      "type": "line",
      "text": "Thus saith the Lord:",
      "verse": "21:8",
      "lineIndex": 43
    },
    {
      "start": 111.382,
      "end": 113.89,
      "type": "line",
      "text": "In an acceptable time have I heard thee,",
      "verse": "21:8",
      "lineIndex": 44
    },
    {
      "start": 114.07,
      "end": 115.556,
      "type": "line",
      "text": "O isles of the sea,",
      "verse": "21:8",
      "lineIndex": 45
    },
    {
      "start": 115.736,
      "end": 118.337,
      "type": "line",
      "text": "and in a day of salvation have I helped thee;",
      "verse": "21:8",
      "lineIndex": 46
    },
    {
      "start": 118.517,
      "end": 120.282,
      "type": "line",
      "text": "and I will preserve thee,",
      "verse": "21:8",
      "lineIndex": 47
    },
    {
      "start": 120.462,
      "end": 124.084,
      "type": "line",
      "text": "and give thee my servant for a covenant of the people,",
      "verse": "21:8",
      "lineIndex": 48
    },
    {
      "start": 124.264,
      "end": 125.982,
      "type": "line",
      "text": "to establish the earth,",
      "verse": "21:8",
      "lineIndex": 49
    },
    {
      "start": 126.162,
      "end": 129.041,
      "type": "line",
      "text": "to cause to inherit the desolate heritages;",
      "verse": "21:8",
      "lineIndex": 50
    },
    {
      "start": 129.721,
      "end": 132.554,
      "type": "line",
      "text": "That thou mayest say to the prisoners: Go forth;",
      "verse": "21:9",
      "lineIndex": 51
    },
    {
      "start": 132.734,
      "end": 134.824,
      "type": "line",
      "text": "to them that sit in darkness:",
      "verse": "21:9",
      "lineIndex": 52
    },
    {
      "start": 135.004,
      "end": 136.351,
      "type": "line",
      "text": "Show yourselves.",
      "verse": "21:9",
      "lineIndex": 53
    },
    {
      "start": 136.531,
      "end": 138.899,
      "type": "line",
      "text": "They shall feed in the ways,",
      "verse": "21:9",
      "lineIndex": 54
    },
    {
      "start": 139.079,
      "end": 142.19,
      "type": "line",
      "text": "and their pastures shall be in all high places.",
      "verse": "21:9",
      "lineIndex": 55
    },
    {
      "start": 142.87,
      "end": 144.774,
      "type": "line",
      "text": "They shall not hunger nor thirst,",
      "verse": "21:10",
      "lineIndex": 56
    },
    {
      "start": 144.954,
      "end": 148.019,
      "type": "line",
      "text": "neither shall the heat nor the sun smite them;",
      "verse": "21:10",
      "lineIndex": 57
    },
    {
      "start": 148.199,
      "end": 151.496,
      "type": "line",
      "text": "for he that hath mercy on them shall lead them,",
      "verse": "21:10",
      "lineIndex": 58
    },
    {
      "start": 151.676,
      "end": 153.766,
      "type": "line",
      "text": "even by the springs of water",
      "verse": "21:10",
      "lineIndex": 59
    },
    {
      "start": 153.946,
      "end": 155.618,
      "type": "line",
      "text": "shall he guide them.",
      "verse": "21:10",
      "lineIndex": 60
    },
    {
      "start": 156.298,
      "end": 158.899,
      "type": "line",
      "text": "And I will make all my mountains a way,",
      "verse": "21:11",
      "lineIndex": 61
    },
    {
      "start": 159.079,
      "end": 161.447,
      "type": "line",
      "text": "and my highways shall be exalted.",
      "verse": "21:11",
      "lineIndex": 62
    },
    {
      "start": 162.127,
      "end": 164.31,
      "type": "line",
      "text": "And then, O house of Israel,",
      "verse": "21:12",
      "lineIndex": 63
    },
    {
      "start": 164.49,
      "end": 166.998,
      "type": "line",
      "text": "behold, these shall come from far;",
      "verse": "21:12",
      "lineIndex": 64
    },
    {
      "start": 167.178,
      "end": 170.522,
      "type": "line",
      "text": "and lo, these from the north and from the west;",
      "verse": "21:12",
      "lineIndex": 65
    },
    {
      "start": 170.702,
      "end": 172.838,
      "type": "line",
      "text": "and these from the land of Sinim.",
      "verse": "21:12",
      "lineIndex": 66
    },
    {
      "start": 173.518,
      "end": 176.258,
      "type": "line",
      "text": "Sing, O heavens; and be joyful, O earth;",
      "verse": "21:13",
      "lineIndex": 68
    },
    {
      "start": 176.438,
      "end": 179.967,
      "type": "line",
      "text": "for the feet of those who are in the east shall be established;",
      "verse": "21:13",
      "lineIndex": 69
    },
    {
      "start": 180.147,
      "end": 182.933,
      "type": "line",
      "text": "and break forth into singing, O mountains;",
      "verse": "21:13",
      "lineIndex": 70
    },
    {
      "start": 183.113,
      "end": 185.156,
      "type": "line",
      "text": "for they shall be smitten no more;",
      "verse": "21:13",
      "lineIndex": 71
    },
    {
      "start": 185.336,
      "end": 187.797,
      "type": "line",
      "text": "for the Lord hath comforted his people,",
      "verse": "21:13",
      "lineIndex": 72
    },
    {
      "start": 187.977,
      "end": 190.438,
      "type": "line",
      "text": "and will have mercy upon his afflicted.",
      "verse": "21:13",
      "lineIndex": 73
    },
    {
      "start": 191.118,
      "end": 194.555,
      "type": "line",
      "text": "But, behold, Zion hath said: The Lord hath forsaken me,",
      "verse": "21:14",
      "lineIndex": 75
    },
    {
      "start": 194.735,
      "end": 196.639,
      "type": "line",
      "text": "and my Lord hath forgotten me\u2014",
      "verse": "21:14",
      "lineIndex": 76
    },
    {
      "start": 196.819,
      "end": 199.095,
      "type": "line",
      "text": "but he will show that he hath not.",
      "verse": "21:14",
      "lineIndex": 77
    },
    {
      "start": 199.775,
      "end": 202.561,
      "type": "line",
      "text": "For can a woman forget her sucking child,",
      "verse": "21:15",
      "lineIndex": 78
    },
    {
      "start": 202.741,
      "end": 206.27,
      "type": "line",
      "text": "that she should not have compassion on the son of her womb?",
      "verse": "21:15",
      "lineIndex": 79
    },
    {
      "start": 206.45,
      "end": 208.075,
      "type": "line",
      "text": "Yea, they may forget,",
      "verse": "21:15",
      "lineIndex": 80
    },
    {
      "start": 208.255,
      "end": 210.949,
      "type": "line",
      "text": "yet will I not forget thee, O house of Israel.",
      "verse": "21:15",
      "lineIndex": 81
    },
    {
      "start": 211.629,
      "end": 215.205,
      "type": "line",
      "text": "Behold, I have graven thee upon the palms of my hands;",
      "verse": "21:16",
      "lineIndex": 82
    },
    {
      "start": 215.385,
      "end": 217.8,
      "type": "line",
      "text": "thy walls are continually before me.",
      "verse": "21:16",
      "lineIndex": 83
    },
    {
      "start": 218.48,
      "end": 221.731,
      "type": "line",
      "text": "Thy children shall make haste against thy destroyers;",
      "verse": "21:17",
      "lineIndex": 84
    },
    {
      "start": 221.911,
      "end": 223.954,
      "type": "line",
      "text": "and they that made thee waste",
      "verse": "21:17",
      "lineIndex": 85
    },
    {
      "start": 224.134,
      "end": 225.806,
      "type": "line",
      "text": "shall go forth of thee.",
      "verse": "21:17",
      "lineIndex": 86
    },
    {
      "start": 226.486,
      "end": 229.272,
      "type": "line",
      "text": "Lift up thine eyes round about and behold;",
      "verse": "21:18",
      "lineIndex": 87
    },
    {
      "start": 229.452,
      "end": 231.82,
      "type": "line",
      "text": "all these gather themselves together,",
      "verse": "21:18",
      "lineIndex": 88
    },
    {
      "start": 232.0,
      "end": 233.811,
      "type": "line",
      "text": "and they shall come to thee.",
      "verse": "21:18",
      "lineIndex": 89
    },
    {
      "start": 233.991,
      "end": 235.384,
      "type": "line",
      "text": "And as I live,",
      "verse": "21:18",
      "lineIndex": 90
    },
    {
      "start": 235.564,
      "end": 236.911,
      "type": "line",
      "text": "saith the Lord,",
      "verse": "21:18",
      "lineIndex": 91
    },
    {
      "start": 237.091,
      "end": 241.317,
      "type": "line",
      "text": "thou shalt surely clothe thee with them all, as with an ornament,",
      "verse": "21:18",
      "lineIndex": 92
    },
    {
      "start": 241.497,
      "end": 244.191,
      "type": "line",
      "text": "and bind them on even as a bride.",
      "verse": "21:18",
      "lineIndex": 93
    },
    {
      "start": 244.871,
      "end": 247.657,
      "type": "line",
      "text": "For thy waste and thy desolate places,",
      "verse": "21:19",
      "lineIndex": 95
    },
    {
      "start": 247.837,
      "end": 254.153,
      "type": "line",
      "text": "and the land of thy destruction, shall even now be too narrow by reason of the inhabitants;",
      "verse": "21:19",
      "lineIndex": 96
    },
    {
      "start": 254.333,
      "end": 257.166,
      "type": "line",
      "text": "and they that swallowed thee up shall be far away.",
      "verse": "21:19",
      "lineIndex": 97
    },
    {
      "start": 257.846,
      "end": 260.4,
      "type": "line",
      "text": "The children whom thou shalt have,",
      "verse": "21:20",
      "lineIndex": 98
    },
    {
      "start": 260.58,
      "end": 262.67,
      "type": "line",
      "text": "after thou hast lost the first,",
      "verse": "21:20",
      "lineIndex": 99
    },
    {
      "start": 262.85,
      "end": 265.126,
      "type": "line",
      "text": "shall again in thine ears say:",
      "verse": "21:20",
      "lineIndex": 100
    },
    {
      "start": 265.306,
      "end": 267.349,
      "type": "line",
      "text": "The place is too strait for me;",
      "verse": "21:20",
      "lineIndex": 101
    },
    {
      "start": 267.529,
      "end": 269.897,
      "type": "line",
      "text": "give place to me that I may dwell.",
      "verse": "21:20",
      "lineIndex": 102
    },
    {
      "start": 270.577,
      "end": 274.432,
      "type": "line",
      "text": "Then shalt thou say in thine heart: Who hath begotten me these,",
      "verse": "21:21",
      "lineIndex": 103
    },
    {
      "start": 274.612,
      "end": 276.934,
      "type": "line",
      "text": "seeing I have lost my children,",
      "verse": "21:21",
      "lineIndex": 104
    },
    {
      "start": 277.114,
      "end": 280.225,
      "type": "line",
      "text": "and am desolate, a captive, and removing to and fro?",
      "verse": "21:21",
      "lineIndex": 105
    },
    {
      "start": 280.405,
      "end": 282.077,
      "type": "line",
      "text": "And who hath brought up these?",
      "verse": "21:21",
      "lineIndex": 106
    },
    {
      "start": 282.257,
      "end": 283.929,
      "type": "line",
      "text": "Behold, I was left alone;",
      "verse": "21:21",
      "lineIndex": 107
    },
    {
      "start": 284.109,
      "end": 285.781,
      "type": "line",
      "text": "these, where have they been?",
      "verse": "21:21",
      "lineIndex": 108
    },
    {
      "start": 286.461,
      "end": 288.365,
      "type": "line",
      "text": "Thus saith the Lord God:",
      "verse": "21:22",
      "lineIndex": 110
    },
    {
      "start": 288.545,
      "end": 291.424,
      "type": "line",
      "text": "Behold, I will lift up mine hand to the Gentiles,",
      "verse": "21:22",
      "lineIndex": 111
    },
    {
      "start": 291.604,
      "end": 294.112,
      "type": "line",
      "text": "and set up my standard to the people;",
      "verse": "21:22",
      "lineIndex": 112
    },
    {
      "start": 294.292,
      "end": 297.171,
      "type": "line",
      "text": "and they shall bring thy sons in their arms,",
      "verse": "21:22",
      "lineIndex": 113
    },
    {
      "start": 297.351,
      "end": 301.113,
      "type": "line",
      "text": "and thy daughters shall be carried upon their shoulders.",
      "verse": "21:22",
      "lineIndex": 114
    },
    {
      "start": 301.793,
      "end": 304.44,
      "type": "line",
      "text": "And kings shall be thy nursing fathers,",
      "verse": "21:23",
      "lineIndex": 115
    },
    {
      "start": 304.62,
      "end": 307.314,
      "type": "line",
      "text": "and their queens thy nursing mothers;",
      "verse": "21:23",
      "lineIndex": 116
    },
    {
      "start": 307.494,
      "end": 311.023,
      "type": "line",
      "text": "they shall bow down to thee with their face towards the earth,",
      "verse": "21:23",
      "lineIndex": 117
    },
    {
      "start": 311.203,
      "end": 313.757,
      "type": "line",
      "text": "and lick up the dust of thy feet;",
      "verse": "21:23",
      "lineIndex": 118
    },
    {
      "start": 313.937,
      "end": 316.213,
      "type": "line",
      "text": "and thou shalt know that I am the Lord;",
      "verse": "21:23",
      "lineIndex": 119
    },
    {
      "start": 316.393,
      "end": 318.994,
      "type": "line",
      "text": "for they shall not be ashamed that wait for me.",
      "verse": "21:23",
      "lineIndex": 120
    },
    {
      "start": 319.674,
      "end": 322.46,
      "type": "line",
      "text": "For shall the prey be taken from the mighty,",
      "verse": "21:24",
      "lineIndex": 122
    },
    {
      "start": 322.64,
      "end": 325.101,
      "type": "line",
      "text": "or the lawful captives delivered?",
      "verse": "21:24",
      "lineIndex": 123
    },
    {
      "start": 325.781,
      "end": 327.546,
      "type": "line",
      "text": "But thus saith the Lord,",
      "verse": "21:25",
      "lineIndex": 124
    },
    {
      "start": 327.726,
      "end": 330.977,
      "type": "line",
      "text": "even the captives of the mighty shall be taken away,",
      "verse": "21:25",
      "lineIndex": 125
    },
    {
      "start": 331.157,
      "end": 333.293,
      "type": "line",
      "text": "and the prey of the terrible",
      "verse": "21:25",
      "lineIndex": 126
    },
    {
      "start": 333.473,
      "end": 335.006,
      "type": "line",
      "text": "shall be delivered;",
      "verse": "21:25",
      "lineIndex": 127
    },
    {
      "start": 335.186,
      "end": 338.437,
      "type": "line",
      "text": "for I will contend with him that contendeth with thee,",
      "verse": "21:25",
      "lineIndex": 128
    },
    {
      "start": 338.617,
      "end": 340.335,
      "type": "line",
      "text": "and I will save thy children.",
      "verse": "21:25",
      "lineIndex": 129
    },
    {
      "start": 341.015,
      "end": 344.73,
      "type": "line",
      "text": "And I will feed them that oppress thee with their own flesh;",
      "verse": "21:26",
      "lineIndex": 130
    },
    {
      "start": 344.91,
      "end": 348.068,
      "type": "line",
      "text": "they shall be drunken with their own blood as with sweet wine;",
      "verse": "21:26",
      "lineIndex": 131
    },
    {
      "start": 348.248,
      "end": 354.564,
      "type": "line",
      "text": "and all flesh shall know that I, the Lord, am thy Savior and thy Redeemer, the Mighty One of Jacob.",
      "verse": "21:26",
      "lineIndex": 132
    }
  ]
}