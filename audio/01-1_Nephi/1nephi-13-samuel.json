{
  "book": "1nephi",
  "bookName": "1 Nephi",
  "chapter": 13,
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "ddDFRErfhdc2asyySOG5",
    "model_id": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.35,
      "use_speaker_boost": true
    },
    "name": "Samuel"
  },
  "pauses": {
    "line_ms": 180,
    "verse_ms": 500
  },
  "duration": 705.564,
  "lines": [
    {
      "start": 0.0,
      "end": 3.437,
      "type": "line",
      "text": "And it came to pass that the angel spake unto me, saying:",
      "verse": "13:1",
      "lineIndex": 1
    },
    {
      "start": 3.617,
      "end": 4.406,
      "type": "line",
      "text": "Look!",
      "verse": "13:1",
      "lineIndex": 2
    },
    {
      "start": 4.586,
      "end": 7.976,
      "type": "line",
      "text": "And I looked and beheld many nations and kingdoms.",
      "verse": "13:1",
      "lineIndex": 3
    },
    {
      "start": 8.656,
      "end": 10.189,
      "type": "line",
      "text": "And the angel said unto me:",
      "verse": "13:2",
      "lineIndex": 4
    },
    {
      "start": 10.369,
      "end": 11.902,
      "type": "line",
      "text": "What beholdest thou?",
      "verse": "13:2",
      "lineIndex": 5
    },
    {
      "start": 12.082,
      "end": 13.336,
      "type": "line",
      "text": "And I said:",
      "verse": "13:2",
      "lineIndex": 6
    },
    {
      "start": 13.516,
      "end": 16.117,
      "type": "line",
      "text": "I behold many nations and kingdoms.",
      "verse": "13:2",
      "lineIndex": 7
    },
    {
      "start": 16.797,
      "end": 18.237,
      "type": "line",
      "text": "And he said unto me:",
      "verse": "13:3",
      "lineIndex": 8
    },
    {
      "start": 18.417,
      "end": 21.714,
      "type": "line",
      "text": "These are the nations and kingdoms of the Gentiles.",
      "verse": "13:3",
      "lineIndex": 9
    },
    {
      "start": 22.394,
      "end": 28.106,
      "type": "line",
      "text": "And it came to pass that I saw among the nations of the Gentiles the formation of a great church.",
      "verse": "13:4",
      "lineIndex": 10
    },
    {
      "start": 28.786,
      "end": 30.319,
      "type": "line",
      "text": "And the angel said unto me:",
      "verse": "13:5",
      "lineIndex": 12
    },
    {
      "start": 30.499,
      "end": 35.84,
      "type": "line",
      "text": "Behold the formation of a church which is most abominable above all other churches,",
      "verse": "13:5",
      "lineIndex": 13
    },
    {
      "start": 36.02,
      "end": 38.342,
      "type": "line",
      "text": "which slayeth the saints of God,",
      "verse": "13:5",
      "lineIndex": 14
    },
    {
      "start": 38.522,
      "end": 41.587,
      "type": "line",
      "text": "yea, and tortureth them and bindeth them down,",
      "verse": "13:5",
      "lineIndex": 15
    },
    {
      "start": 41.767,
      "end": 44.507,
      "type": "line",
      "text": "and yoketh them with a yoke of iron,",
      "verse": "13:5",
      "lineIndex": 16
    },
    {
      "start": 44.687,
      "end": 47.241,
      "type": "line",
      "text": "and bringeth them down into captivity.",
      "verse": "13:5",
      "lineIndex": 17
    },
    {
      "start": 47.921,
      "end": 52.193,
      "type": "line",
      "text": "And it came to pass that I beheld this great and abominable church;",
      "verse": "13:6",
      "lineIndex": 18
    },
    {
      "start": 52.373,
      "end": 53.998,
      "type": "line",
      "text": "and I saw the devil",
      "verse": "13:6",
      "lineIndex": 19
    },
    {
      "start": 54.178,
      "end": 56.128,
      "type": "line",
      "text": "that he was the founder of it.",
      "verse": "13:6",
      "lineIndex": 20
    },
    {
      "start": 56.808,
      "end": 59.223,
      "type": "line",
      "text": "And I also saw gold, and silver,",
      "verse": "13:7",
      "lineIndex": 21
    },
    {
      "start": 59.403,
      "end": 62.979,
      "type": "line",
      "text": "and silks, and scarlets, and fine-twined linen,",
      "verse": "13:7",
      "lineIndex": 22
    },
    {
      "start": 63.159,
      "end": 65.481,
      "type": "line",
      "text": "and all manner of precious clothing;",
      "verse": "13:7",
      "lineIndex": 23
    },
    {
      "start": 65.661,
      "end": 67.194,
      "type": "line",
      "text": "and I saw many harlots.",
      "verse": "13:7",
      "lineIndex": 24
    },
    {
      "start": 67.874,
      "end": 70.242,
      "type": "line",
      "text": "And the angel spake unto me, saying:",
      "verse": "13:8",
      "lineIndex": 25
    },
    {
      "start": 70.422,
      "end": 72.698,
      "type": "line",
      "text": "Behold the gold, and the silver,",
      "verse": "13:8",
      "lineIndex": 26
    },
    {
      "start": 72.878,
      "end": 77.383,
      "type": "line",
      "text": "and the silks, and the scarlets, and the fine-twined linen,",
      "verse": "13:8",
      "lineIndex": 27
    },
    {
      "start": 77.563,
      "end": 80.071,
      "type": "line",
      "text": "and the precious clothing, and the harlots,",
      "verse": "13:8",
      "lineIndex": 28
    },
    {
      "start": 80.251,
      "end": 84.106,
      "type": "line",
      "text": "are the desires of this great and abominable church.",
      "verse": "13:8",
      "lineIndex": 29
    },
    {
      "start": 84.786,
      "end": 87.015,
      "type": "line",
      "text": "And also for the praise of the world",
      "verse": "13:9",
      "lineIndex": 30
    },
    {
      "start": 87.195,
      "end": 89.378,
      "type": "line",
      "text": "do they destroy the saints of God,",
      "verse": "13:9",
      "lineIndex": 31
    },
    {
      "start": 89.558,
      "end": 91.926,
      "type": "line",
      "text": "and bring them down into captivity.",
      "verse": "13:9",
      "lineIndex": 32
    },
    {
      "start": 92.606,
      "end": 96.275,
      "type": "line",
      "text": "And it came to pass that I looked and beheld many waters;",
      "verse": "13:10",
      "lineIndex": 33
    },
    {
      "start": 96.455,
      "end": 99.938,
      "type": "line",
      "text": "and they divided the Gentiles from the seed of my brethren.",
      "verse": "13:10",
      "lineIndex": 34
    },
    {
      "start": 100.618,
      "end": 103.544,
      "type": "line",
      "text": "And it came to pass that the angel said unto me:",
      "verse": "13:11",
      "lineIndex": 35
    },
    {
      "start": 103.724,
      "end": 106.789,
      "type": "line",
      "text": "Behold the wrath of God is upon the seed of thy brethren.",
      "verse": "13:11",
      "lineIndex": 36
    },
    {
      "start": 107.469,
      "end": 110.813,
      "type": "line",
      "text": "And I looked and beheld a man among the Gentiles,",
      "verse": "13:12",
      "lineIndex": 38
    },
    {
      "start": 110.993,
      "end": 115.591,
      "type": "line",
      "text": "who was separated from the seed of my brethren by the many waters;",
      "verse": "13:12",
      "lineIndex": 39
    },
    {
      "start": 115.771,
      "end": 117.861,
      "type": "line",
      "text": "and I beheld the Spirit of God,",
      "verse": "13:12",
      "lineIndex": 40
    },
    {
      "start": 118.041,
      "end": 120.735,
      "type": "line",
      "text": "that it came down and wrought upon the man;",
      "verse": "13:12",
      "lineIndex": 41
    },
    {
      "start": 120.915,
      "end": 128.16,
      "type": "line",
      "text": "and he went forth upon the many waters, even unto the seed of my brethren, who were in the promised land.",
      "verse": "13:12",
      "lineIndex": 42
    },
    {
      "start": 128.84,
      "end": 134.691,
      "type": "line",
      "text": "And it came to pass that I beheld the Spirit of God, that it wrought upon other Gentiles;",
      "verse": "13:13",
      "lineIndex": 43
    },
    {
      "start": 134.871,
      "end": 138.818,
      "type": "line",
      "text": "and they went forth out of captivity, upon the many waters.",
      "verse": "13:13",
      "lineIndex": 44
    },
    {
      "start": 139.498,
      "end": 141.959,
      "type": "line",
      "text": "And it came to pass that I beheld",
      "verse": "13:14",
      "lineIndex": 45
    },
    {
      "start": 142.139,
      "end": 145.808,
      "type": "line",
      "text": "many multitudes of the Gentiles upon the land of promise;",
      "verse": "13:14",
      "lineIndex": 46
    },
    {
      "start": 145.988,
      "end": 148.356,
      "type": "line",
      "text": "and I beheld the wrath of God,",
      "verse": "13:14",
      "lineIndex": 47
    },
    {
      "start": 148.536,
      "end": 151.276,
      "type": "line",
      "text": "that it was upon the seed of my brethren;",
      "verse": "13:14",
      "lineIndex": 48
    },
    {
      "start": 151.456,
      "end": 154.66,
      "type": "line",
      "text": "and they were scattered before the Gentiles and were smitten.",
      "verse": "13:14",
      "lineIndex": 49
    },
    {
      "start": 155.34,
      "end": 157.523,
      "type": "line",
      "text": "And I beheld the Spirit of the Lord,",
      "verse": "13:15",
      "lineIndex": 50
    },
    {
      "start": 157.703,
      "end": 160.675,
      "type": "line",
      "text": "that it was upon the Gentiles, and they did prosper",
      "verse": "13:15",
      "lineIndex": 51
    },
    {
      "start": 160.855,
      "end": 163.363,
      "type": "line",
      "text": "and obtain the land for their inheritance;",
      "verse": "13:15",
      "lineIndex": 52
    },
    {
      "start": 163.543,
      "end": 165.819,
      "type": "line",
      "text": "and I beheld that they were white,",
      "verse": "13:15",
      "lineIndex": 53
    },
    {
      "start": 165.999,
      "end": 168.275,
      "type": "line",
      "text": "and exceedingly fair and beautiful,",
      "verse": "13:15",
      "lineIndex": 54
    },
    {
      "start": 168.455,
      "end": 171.009,
      "type": "line",
      "text": "like unto my people before they were slain.",
      "verse": "13:15",
      "lineIndex": 55
    },
    {
      "start": 171.689,
      "end": 177.68,
      "type": "line",
      "text": "And it came to pass that I, Nephi, beheld that the Gentiles who had gone forth out of captivity",
      "verse": "13:16",
      "lineIndex": 56
    },
    {
      "start": 177.86,
      "end": 180.089,
      "type": "line",
      "text": "did humble themselves before the Lord;",
      "verse": "13:16",
      "lineIndex": 57
    },
    {
      "start": 180.269,
      "end": 182.591,
      "type": "line",
      "text": "and the power of the Lord was with them.",
      "verse": "13:16",
      "lineIndex": 58
    },
    {
      "start": 183.271,
      "end": 188.24,
      "type": "line",
      "text": "And I beheld that their mother Gentiles were gathered together upon the waters,",
      "verse": "13:17",
      "lineIndex": 59
    },
    {
      "start": 188.42,
      "end": 191.81,
      "type": "line",
      "text": "and upon the land also, to battle against them.",
      "verse": "13:17",
      "lineIndex": 60
    },
    {
      "start": 192.49,
      "end": 195.834,
      "type": "line",
      "text": "And I beheld that the power of God was with them,",
      "verse": "13:18",
      "lineIndex": 61
    },
    {
      "start": 196.014,
      "end": 199.776,
      "type": "line",
      "text": "and also that the wrath of God was upon all those",
      "verse": "13:18",
      "lineIndex": 62
    },
    {
      "start": 199.956,
      "end": 203.764,
      "type": "line",
      "text": "that were gathered together against them to battle.",
      "verse": "13:18",
      "lineIndex": 63
    },
    {
      "start": 204.444,
      "end": 209.367,
      "type": "line",
      "text": "And I, Nephi, beheld that the Gentiles that had gone out of captivity",
      "verse": "13:19",
      "lineIndex": 64
    },
    {
      "start": 209.547,
      "end": 214.191,
      "type": "line",
      "text": "were delivered by the power of God out of the hands of all other nations.",
      "verse": "13:19",
      "lineIndex": 65
    },
    {
      "start": 214.871,
      "end": 221.001,
      "type": "line",
      "text": "And it came to pass that I, Nephi, beheld that they did prosper in the land;",
      "verse": "13:20",
      "lineIndex": 66
    },
    {
      "start": 221.181,
      "end": 222.899,
      "type": "line",
      "text": "and I beheld a book,",
      "verse": "13:20",
      "lineIndex": 67
    },
    {
      "start": 223.079,
      "end": 225.54,
      "type": "line",
      "text": "and it was carried forth among them.",
      "verse": "13:20",
      "lineIndex": 68
    },
    {
      "start": 226.22,
      "end": 227.753,
      "type": "line",
      "text": "And the angel said unto me:",
      "verse": "13:21",
      "lineIndex": 69
    },
    {
      "start": 227.933,
      "end": 230.162,
      "type": "line",
      "text": "Knowest thou the meaning of the book?",
      "verse": "13:21",
      "lineIndex": 70
    },
    {
      "start": 230.842,
      "end": 232.467,
      "type": "line",
      "text": "And I said unto him:",
      "verse": "13:22",
      "lineIndex": 71
    },
    {
      "start": 232.647,
      "end": 233.808,
      "type": "line",
      "text": "I know not.",
      "verse": "13:22",
      "lineIndex": 72
    },
    {
      "start": 234.488,
      "end": 235.788,
      "type": "line",
      "text": "And he said:",
      "verse": "13:23",
      "lineIndex": 74
    },
    {
      "start": 235.968,
      "end": 238.801,
      "type": "line",
      "text": "Behold it proceedeth out of the mouth of a Jew.",
      "verse": "13:23",
      "lineIndex": 75
    },
    {
      "start": 238.981,
      "end": 241.071,
      "type": "line",
      "text": "And I, Nephi, beheld it;",
      "verse": "13:23",
      "lineIndex": 76
    },
    {
      "start": 241.251,
      "end": 242.784,
      "type": "line",
      "text": "and he said unto me:",
      "verse": "13:23",
      "lineIndex": 77
    },
    {
      "start": 242.964,
      "end": 246.819,
      "type": "line",
      "text": "The book that thou beholdest is a record of the Jews,",
      "verse": "13:23",
      "lineIndex": 78
    },
    {
      "start": 246.999,
      "end": 249.553,
      "type": "line",
      "text": "which contains the covenants of the Lord,",
      "verse": "13:23",
      "lineIndex": 79
    },
    {
      "start": 249.733,
      "end": 252.844,
      "type": "line",
      "text": "which he hath made unto the house of Israel;",
      "verse": "13:23",
      "lineIndex": 80
    },
    {
      "start": 253.024,
      "end": 257.807,
      "type": "line",
      "text": "and it also containeth many of the prophecies of the holy prophets;",
      "verse": "13:23",
      "lineIndex": 81
    },
    {
      "start": 257.987,
      "end": 262.863,
      "type": "line",
      "text": "and it is a record like unto the engravings which are upon the plates of brass,",
      "verse": "13:23",
      "lineIndex": 82
    },
    {
      "start": 263.043,
      "end": 264.947,
      "type": "line",
      "text": "save there are not so many;",
      "verse": "13:23",
      "lineIndex": 83
    },
    {
      "start": 265.127,
      "end": 268.192,
      "type": "line",
      "text": "nevertheless, they contain the covenants of the Lord,",
      "verse": "13:23",
      "lineIndex": 84
    },
    {
      "start": 268.372,
      "end": 271.483,
      "type": "line",
      "text": "which he hath made unto the house of Israel;",
      "verse": "13:23",
      "lineIndex": 85
    },
    {
      "start": 271.663,
      "end": 274.821,
      "type": "line",
      "text": "wherefore, they are of great worth unto the Gentiles.",
      "verse": "13:23",
      "lineIndex": 86
    },
    {
      "start": 275.501,
      "end": 277.73,
      "type": "line",
      "text": "And the angel of the Lord said unto me:",
      "verse": "13:24",
      "lineIndex": 87
    },
    {
      "start": 277.91,
      "end": 282.786,
      "type": "line",
      "text": "Thou hast beheld that the book proceeded forth from the mouth of a Jew;",
      "verse": "13:24",
      "lineIndex": 88
    },
    {
      "start": 282.966,
      "end": 285.938,
      "type": "line",
      "text": "and when it proceeded forth from the mouth of a Jew",
      "verse": "13:24",
      "lineIndex": 89
    },
    {
      "start": 286.118,
      "end": 289.415,
      "type": "line",
      "text": "it contained the fulness of the gospel of the Lord,",
      "verse": "13:24",
      "lineIndex": 90
    },
    {
      "start": 289.595,
      "end": 292.056,
      "type": "line",
      "text": "of whom the twelve apostles bear record;",
      "verse": "13:24",
      "lineIndex": 91
    },
    {
      "start": 292.236,
      "end": 296.462,
      "type": "line",
      "text": "and they bear record according to the truth which is in the Lamb of God.",
      "verse": "13:24",
      "lineIndex": 92
    },
    {
      "start": 297.142,
      "end": 303.969,
      "type": "line",
      "text": "Wherefore, these things go forth from the Jews in purity unto the Gentiles, according to the truth which is in God.",
      "verse": "13:25",
      "lineIndex": 93
    },
    {
      "start": 304.649,
      "end": 310.593,
      "type": "line",
      "text": "And after they go forth by the hand of the twelve apostles of the Lamb, from the Jews unto the Gentiles,",
      "verse": "13:26",
      "lineIndex": 95
    },
    {
      "start": 310.773,
      "end": 315.742,
      "type": "line",
      "text": "thou seest the formation of that great and abominable church,",
      "verse": "13:26",
      "lineIndex": 96
    },
    {
      "start": 315.922,
      "end": 319.451,
      "type": "line",
      "text": "which is most abominable above all other churches;",
      "verse": "13:26",
      "lineIndex": 97
    },
    {
      "start": 319.631,
      "end": 323.346,
      "type": "line",
      "text": "for behold, they have taken away from the gospel of the Lamb",
      "verse": "13:26",
      "lineIndex": 98
    },
    {
      "start": 323.526,
      "end": 326.359,
      "type": "line",
      "text": "many parts which are plain and most precious;",
      "verse": "13:26",
      "lineIndex": 99
    },
    {
      "start": 326.539,
      "end": 329.697,
      "type": "line",
      "text": "and also many covenants of the Lord have they taken away.",
      "verse": "13:26",
      "lineIndex": 100
    },
    {
      "start": 330.377,
      "end": 332.142,
      "type": "line",
      "text": "And all this have they done",
      "verse": "13:27",
      "lineIndex": 101
    },
    {
      "start": 332.322,
      "end": 335.248,
      "type": "line",
      "text": "that they might pervert the right ways of the Lord,",
      "verse": "13:27",
      "lineIndex": 102
    },
    {
      "start": 335.428,
      "end": 337.75,
      "type": "line",
      "text": "that they might blind the eyes",
      "verse": "13:27",
      "lineIndex": 103
    },
    {
      "start": 337.93,
      "end": 340.716,
      "type": "line",
      "text": "and harden the hearts of the children of men.",
      "verse": "13:27",
      "lineIndex": 104
    },
    {
      "start": 341.396,
      "end": 343.068,
      "type": "line",
      "text": "Wherefore, thou seest",
      "verse": "13:28",
      "lineIndex": 105
    },
    {
      "start": 343.248,
      "end": 348.635,
      "type": "line",
      "text": "that after the book hath gone forth through the hands of the great and abominable church,",
      "verse": "13:28",
      "lineIndex": 106
    },
    {
      "start": 348.815,
      "end": 354.109,
      "type": "line",
      "text": "that there are many plain and precious things taken away from the book,",
      "verse": "13:28",
      "lineIndex": 107
    },
    {
      "start": 354.289,
      "end": 356.611,
      "type": "line",
      "text": "which is the book of the Lamb of God.",
      "verse": "13:28",
      "lineIndex": 108
    },
    {
      "start": 357.291,
      "end": 360.495,
      "type": "line",
      "text": "And after these plain and precious things were taken away",
      "verse": "13:29",
      "lineIndex": 109
    },
    {
      "start": 360.675,
      "end": 363.879,
      "type": "line",
      "text": "it goeth forth unto all the nations of the Gentiles;",
      "verse": "13:29",
      "lineIndex": 110
    },
    {
      "start": 364.059,
      "end": 367.821,
      "type": "line",
      "text": "and after it goeth forth unto all the nations of the Gentiles,",
      "verse": "13:29",
      "lineIndex": 111
    },
    {
      "start": 368.001,
      "end": 371.345,
      "type": "line",
      "text": "yea, even across the many waters which thou hast seen",
      "verse": "13:29",
      "lineIndex": 112
    },
    {
      "start": 371.525,
      "end": 375.101,
      "type": "line",
      "text": "with the Gentiles which have gone forth out of captivity,",
      "verse": "13:29",
      "lineIndex": 113
    },
    {
      "start": 375.281,
      "end": 378.718,
      "type": "line",
      "text": "thou seest\u2014 because of the many plain and precious things",
      "verse": "13:29",
      "lineIndex": 114
    },
    {
      "start": 378.898,
      "end": 381.127,
      "type": "line",
      "text": "which have been taken out of the book,",
      "verse": "13:29",
      "lineIndex": 115
    },
    {
      "start": 381.307,
      "end": 388.83,
      "type": "line",
      "text": "which were plain unto the understanding of the children of men, according to the plainness which is in the Lamb of God\u2014",
      "verse": "13:29",
      "lineIndex": 116
    },
    {
      "start": 389.01,
      "end": 394.072,
      "type": "line",
      "text": "because of these things which are taken away out of the gospel of the Lamb,",
      "verse": "13:29",
      "lineIndex": 117
    },
    {
      "start": 394.252,
      "end": 396.481,
      "type": "line",
      "text": "an exceedingly great many do stumble,",
      "verse": "13:29",
      "lineIndex": 118
    },
    {
      "start": 396.661,
      "end": 400.237,
      "type": "line",
      "text": "yea, insomuch that Satan hath great power over them.",
      "verse": "13:29",
      "lineIndex": 119
    },
    {
      "start": 400.917,
      "end": 403.796,
      "type": "line",
      "text": "Nevertheless, thou beholdest that the Gentiles",
      "verse": "13:30",
      "lineIndex": 120
    },
    {
      "start": 403.976,
      "end": 406.809,
      "type": "line",
      "text": "who have gone forth out of captivity,",
      "verse": "13:30",
      "lineIndex": 121
    },
    {
      "start": 406.989,
      "end": 414.977,
      "type": "line",
      "text": "and have been lifted up by the power of God above all other nations, upon the face of the land which is choice above all other lands,",
      "verse": "13:30",
      "lineIndex": 122
    },
    {
      "start": 415.157,
      "end": 424.027,
      "type": "line",
      "text": "which is the land that the Lord God hath covenanted with thy father that his seed should have for the land of their inheritance;",
      "verse": "13:30",
      "lineIndex": 123
    },
    {
      "start": 424.207,
      "end": 427.411,
      "type": "line",
      "text": "wherefore, thou seest that the Lord God will not suffer",
      "verse": "13:30",
      "lineIndex": 124
    },
    {
      "start": 427.591,
      "end": 431.585,
      "type": "line",
      "text": "that the Gentiles will utterly destroy the mixture of thy seed,",
      "verse": "13:30",
      "lineIndex": 125
    },
    {
      "start": 431.765,
      "end": 433.762,
      "type": "line",
      "text": "which are among thy brethren.",
      "verse": "13:30",
      "lineIndex": 126
    },
    {
      "start": 434.442,
      "end": 439.597,
      "type": "line",
      "text": "Neither will he suffer that the Gentiles shall destroy the seed of thy brethren.",
      "verse": "13:31",
      "lineIndex": 127
    },
    {
      "start": 440.277,
      "end": 447.986,
      "type": "line",
      "text": "Neither will the Lord God suffer that the Gentiles shall forever remain in that awful state of blindness,",
      "verse": "13:32",
      "lineIndex": 128
    },
    {
      "start": 448.166,
      "end": 450.302,
      "type": "line",
      "text": "which thou beholdest they are in,",
      "verse": "13:32",
      "lineIndex": 129
    },
    {
      "start": 450.482,
      "end": 455.405,
      "type": "line",
      "text": "because of the plain and most precious parts of the gospel of the Lamb",
      "verse": "13:32",
      "lineIndex": 130
    },
    {
      "start": 455.585,
      "end": 459.393,
      "type": "line",
      "text": "which have been kept back by that abominable church,",
      "verse": "13:32",
      "lineIndex": 131
    },
    {
      "start": 459.573,
      "end": 461.616,
      "type": "line",
      "text": "whose formation thou hast seen.",
      "verse": "13:32",
      "lineIndex": 132
    },
    {
      "start": 462.296,
      "end": 464.432,
      "type": "line",
      "text": "Wherefore saith the Lamb of God:",
      "verse": "13:33",
      "lineIndex": 134
    },
    {
      "start": 464.612,
      "end": 471.16,
      "type": "line",
      "text": "I will be merciful unto the Gentiles, unto the visiting of the remnant of the house of Israel in great judgment.",
      "verse": "13:33",
      "lineIndex": 135
    },
    {
      "start": 471.84,
      "end": 475.88,
      "type": "line",
      "text": "And it came to pass that the angel of the Lord spake unto me, saying:",
      "verse": "13:34",
      "lineIndex": 136
    },
    {
      "start": 476.06,
      "end": 478.01,
      "type": "line",
      "text": "Behold, saith the Lamb of God,",
      "verse": "13:34",
      "lineIndex": 137
    },
    {
      "start": 478.19,
      "end": 481.905,
      "type": "line",
      "text": "after I have visited the remnant of the house of Israel\u2014",
      "verse": "13:34",
      "lineIndex": 138
    },
    {
      "start": 482.085,
      "end": 485.475,
      "type": "line",
      "text": "and this remnant of whom I speak is the seed of thy father\u2014",
      "verse": "13:34",
      "lineIndex": 139
    },
    {
      "start": 485.655,
      "end": 489.556,
      "type": "line",
      "text": "wherefore, after I have visited them in judgment,",
      "verse": "13:34",
      "lineIndex": 140
    },
    {
      "start": 489.736,
      "end": 492.383,
      "type": "line",
      "text": "and smitten them by the hand of the Gentiles,",
      "verse": "13:34",
      "lineIndex": 141
    },
    {
      "start": 492.563,
      "end": 499.622,
      "type": "line",
      "text": "and after the Gentiles do stumble exceedingly, because of the most plain and precious parts of the gospel of the Lamb",
      "verse": "13:34",
      "lineIndex": 142
    },
    {
      "start": 499.802,
      "end": 503.61,
      "type": "line",
      "text": "which have been kept back by that abominable church,",
      "verse": "13:34",
      "lineIndex": 143
    },
    {
      "start": 503.79,
      "end": 505.88,
      "type": "line",
      "text": "which is the mother of harlots,",
      "verse": "13:34",
      "lineIndex": 144
    },
    {
      "start": 506.06,
      "end": 507.593,
      "type": "line",
      "text": "saith the Lamb\u2014",
      "verse": "13:34",
      "lineIndex": 145
    },
    {
      "start": 507.773,
      "end": 511.024,
      "type": "line",
      "text": "I will be merciful unto the Gentiles in that day,",
      "verse": "13:34",
      "lineIndex": 146
    },
    {
      "start": 511.204,
      "end": 515.105,
      "type": "line",
      "text": "insomuch that I will bring forth unto them, in mine own power,",
      "verse": "13:34",
      "lineIndex": 147
    },
    {
      "start": 515.285,
      "end": 516.818,
      "type": "line",
      "text": "much of my gospel,",
      "verse": "13:34",
      "lineIndex": 148
    },
    {
      "start": 516.998,
      "end": 519.134,
      "type": "line",
      "text": "which shall be plain and precious,",
      "verse": "13:34",
      "lineIndex": 149
    },
    {
      "start": 519.314,
      "end": 520.614,
      "type": "line",
      "text": "saith the Lamb.",
      "verse": "13:34",
      "lineIndex": 150
    },
    {
      "start": 521.294,
      "end": 523.198,
      "type": "line",
      "text": "For, behold, saith the Lamb:",
      "verse": "13:35",
      "lineIndex": 151
    },
    {
      "start": 523.378,
      "end": 525.932,
      "type": "line",
      "text": "I will manifest myself unto thy seed,",
      "verse": "13:35",
      "lineIndex": 152
    },
    {
      "start": 526.112,
      "end": 528.388,
      "type": "line",
      "text": "that they shall write many things",
      "verse": "13:35",
      "lineIndex": 153
    },
    {
      "start": 528.568,
      "end": 530.751,
      "type": "line",
      "text": "which I shall minister unto them,",
      "verse": "13:35",
      "lineIndex": 154
    },
    {
      "start": 530.931,
      "end": 533.253,
      "type": "line",
      "text": "which shall be plain and precious;",
      "verse": "13:35",
      "lineIndex": 155
    },
    {
      "start": 533.433,
      "end": 535.848,
      "type": "line",
      "text": "and after thy seed shall be destroyed,",
      "verse": "13:35",
      "lineIndex": 156
    },
    {
      "start": 536.028,
      "end": 537.793,
      "type": "line",
      "text": "and dwindle in unbelief,",
      "verse": "13:35",
      "lineIndex": 157
    },
    {
      "start": 537.973,
      "end": 540.295,
      "type": "line",
      "text": "and also the seed of thy brethren,",
      "verse": "13:35",
      "lineIndex": 158
    },
    {
      "start": 540.475,
      "end": 542.797,
      "type": "line",
      "text": "behold, these things shall be hid up,",
      "verse": "13:35",
      "lineIndex": 159
    },
    {
      "start": 542.977,
      "end": 547.482,
      "type": "line",
      "text": "to come forth unto the Gentiles, by the gift and power of the Lamb.",
      "verse": "13:35",
      "lineIndex": 160
    },
    {
      "start": 548.162,
      "end": 551.459,
      "type": "line",
      "text": "And in them shall be written my gospel, saith the Lamb,",
      "verse": "13:36",
      "lineIndex": 161
    },
    {
      "start": 551.639,
      "end": 553.729,
      "type": "line",
      "text": "and my rock and my salvation.",
      "verse": "13:36",
      "lineIndex": 162
    },
    {
      "start": 554.409,
      "end": 555.988,
      "type": "line",
      "text": "And blessed are they",
      "verse": "13:37",
      "lineIndex": 163
    },
    {
      "start": 556.168,
      "end": 559.465,
      "type": "line",
      "text": "who shall seek to bring forth my Zion at that day,",
      "verse": "13:37",
      "lineIndex": 164
    },
    {
      "start": 559.645,
      "end": 561.967,
      "type": "line",
      "text": "for they shall have the gift",
      "verse": "13:37",
      "lineIndex": 165
    },
    {
      "start": 562.147,
      "end": 564.283,
      "type": "line",
      "text": "and the power of the Holy Ghost;",
      "verse": "13:37",
      "lineIndex": 166
    },
    {
      "start": 564.463,
      "end": 566.831,
      "type": "line",
      "text": "and if they endure unto the end",
      "verse": "13:37",
      "lineIndex": 167
    },
    {
      "start": 567.011,
      "end": 569.426,
      "type": "line",
      "text": "they shall be lifted up at the last day,",
      "verse": "13:37",
      "lineIndex": 168
    },
    {
      "start": 569.606,
      "end": 572.95,
      "type": "line",
      "text": "and shall be saved in the everlasting kingdom of the Lamb;",
      "verse": "13:37",
      "lineIndex": 169
    },
    {
      "start": 573.13,
      "end": 575.313,
      "type": "line",
      "text": "and whoso shall publish peace,",
      "verse": "13:37",
      "lineIndex": 170
    },
    {
      "start": 575.493,
      "end": 577.397,
      "type": "line",
      "text": "yea, tidings of great joy,",
      "verse": "13:37",
      "lineIndex": 171
    },
    {
      "start": 577.577,
      "end": 580.642,
      "type": "line",
      "text": "how beautiful upon the mountains shall they be.",
      "verse": "13:37",
      "lineIndex": 172
    },
    {
      "start": 581.322,
      "end": 585.827,
      "type": "line",
      "text": "And it came to pass that I beheld the remnant of the seed of my brethren,",
      "verse": "13:38",
      "lineIndex": 173
    },
    {
      "start": 586.007,
      "end": 588.283,
      "type": "line",
      "text": "and also the book of the Lamb of God,",
      "verse": "13:38",
      "lineIndex": 174
    },
    {
      "start": 588.463,
      "end": 591.621,
      "type": "line",
      "text": "which had proceeded forth from the mouth of the Jew,",
      "verse": "13:38",
      "lineIndex": 175
    },
    {
      "start": 591.801,
      "end": 597.327,
      "type": "line",
      "text": "that it came forth from the Gentiles unto the remnant of the seed of my brethren.",
      "verse": "13:38",
      "lineIndex": 176
    },
    {
      "start": 598.007,
      "end": 600.747,
      "type": "line",
      "text": "And after it had come forth unto them",
      "verse": "13:39",
      "lineIndex": 177
    },
    {
      "start": 600.927,
      "end": 602.413,
      "type": "line",
      "text": "I beheld other books,",
      "verse": "13:39",
      "lineIndex": 178
    },
    {
      "start": 602.593,
      "end": 611.138,
      "type": "line",
      "text": "which came forth by the power of the Lamb, from the Gentiles unto them, unto the convincing of the Gentiles",
      "verse": "13:39",
      "lineIndex": 179
    },
    {
      "start": 611.318,
      "end": 614.151,
      "type": "line",
      "text": "and the remnant of the seed of my brethren,",
      "verse": "13:39",
      "lineIndex": 180
    },
    {
      "start": 614.331,
      "end": 619.114,
      "type": "line",
      "text": "and also the Jews who were scattered upon all the face of the earth,",
      "verse": "13:39",
      "lineIndex": 181
    },
    {
      "start": 619.294,
      "end": 621.802,
      "type": "line",
      "text": "that the records of the prophets",
      "verse": "13:39",
      "lineIndex": 182
    },
    {
      "start": 621.982,
      "end": 625.047,
      "type": "line",
      "text": "and of the twelve apostles of the Lamb are true.",
      "verse": "13:39",
      "lineIndex": 183
    },
    {
      "start": 625.727,
      "end": 628.095,
      "type": "line",
      "text": "And the angel spake unto me, saying:",
      "verse": "13:40",
      "lineIndex": 184
    },
    {
      "start": 628.275,
      "end": 629.761,
      "type": "line",
      "text": "These last records,",
      "verse": "13:40",
      "lineIndex": 185
    },
    {
      "start": 629.941,
      "end": 632.495,
      "type": "line",
      "text": "which thou hast seen among the Gentiles,",
      "verse": "13:40",
      "lineIndex": 186
    },
    {
      "start": 632.675,
      "end": 635.229,
      "type": "line",
      "text": "shall establish the truth of the first,",
      "verse": "13:40",
      "lineIndex": 187
    },
    {
      "start": 635.409,
      "end": 638.195,
      "type": "line",
      "text": "which are of the twelve apostles of the Lamb,",
      "verse": "13:40",
      "lineIndex": 188
    },
    {
      "start": 638.375,
      "end": 641.812,
      "type": "line",
      "text": "and shall make known the plain and precious things",
      "verse": "13:40",
      "lineIndex": 189
    },
    {
      "start": 641.992,
      "end": 644.221,
      "type": "line",
      "text": "which have been taken away from them;",
      "verse": "13:40",
      "lineIndex": 190
    },
    {
      "start": 644.401,
      "end": 647.884,
      "type": "line",
      "text": "and shall make known to all kindreds, tongues, and people,",
      "verse": "13:40",
      "lineIndex": 191
    },
    {
      "start": 648.064,
      "end": 651.361,
      "type": "line",
      "text": "that the Lamb of God is the Son of the Eternal Father,",
      "verse": "13:40",
      "lineIndex": 192
    },
    {
      "start": 651.541,
      "end": 653.491,
      "type": "line",
      "text": "and the Savior of the world;",
      "verse": "13:40",
      "lineIndex": 193
    },
    {
      "start": 653.671,
      "end": 655.993,
      "type": "line",
      "text": "and that all men must come unto him,",
      "verse": "13:40",
      "lineIndex": 194
    },
    {
      "start": 656.173,
      "end": 657.891,
      "type": "line",
      "text": "or they cannot be saved.",
      "verse": "13:40",
      "lineIndex": 195
    },
    {
      "start": 658.571,
      "end": 660.893,
      "type": "line",
      "text": "And they must come according to the words",
      "verse": "13:41",
      "lineIndex": 196
    },
    {
      "start": 661.073,
      "end": 664.37,
      "type": "line",
      "text": "which shall be established by the mouth of the Lamb;",
      "verse": "13:41",
      "lineIndex": 197
    },
    {
      "start": 664.55,
      "end": 666.64,
      "type": "line",
      "text": "and the words of the Lamb",
      "verse": "13:41",
      "lineIndex": 198
    },
    {
      "start": 666.82,
      "end": 670.257,
      "type": "line",
      "text": "shall be made known in the records of thy seed,",
      "verse": "13:41",
      "lineIndex": 199
    },
    {
      "start": 670.437,
      "end": 674.292,
      "type": "line",
      "text": "as well as in the records of the twelve apostles of the Lamb;",
      "verse": "13:41",
      "lineIndex": 200
    },
    {
      "start": 674.472,
      "end": 677.305,
      "type": "line",
      "text": "wherefore they both shall be established in one;",
      "verse": "13:41",
      "lineIndex": 201
    },
    {
      "start": 677.485,
      "end": 681.34,
      "type": "line",
      "text": "for there is one God and one Shepherd over all the earth.",
      "verse": "13:41",
      "lineIndex": 202
    },
    {
      "start": 682.02,
      "end": 686.153,
      "type": "line",
      "text": "And the time cometh that he shall manifest himself unto all nations,",
      "verse": "13:42",
      "lineIndex": 203
    },
    {
      "start": 686.333,
      "end": 688.051,
      "type": "line",
      "text": "both unto the Jews",
      "verse": "13:42",
      "lineIndex": 204
    },
    {
      "start": 688.231,
      "end": 690.228,
      "type": "line",
      "text": "and also unto the Gentiles;",
      "verse": "13:42",
      "lineIndex": 205
    },
    {
      "start": 690.408,
      "end": 693.566,
      "type": "line",
      "text": "and after he has manifested himself unto the Jews",
      "verse": "13:42",
      "lineIndex": 206
    },
    {
      "start": 693.746,
      "end": 695.743,
      "type": "line",
      "text": "and also unto the Gentiles,",
      "verse": "13:42",
      "lineIndex": 207
    },
    {
      "start": 695.923,
      "end": 699.127,
      "type": "line",
      "text": "then he shall manifest himself unto the Gentiles",
      "verse": "13:42",
      "lineIndex": 208
    },
    {
      "start": 699.307,
      "end": 700.979,
      "type": "line",
      "text": "and also unto the Jews,",
      "verse": "13:42",
      "lineIndex": 209
    },
    {
      "start": 701.159,
      "end": 702.97,
      "type": "line",
      "text": "and the last shall be first,",
      "verse": "13:42",
      "lineIndex": 210
    },
    {
      "start": 703.15,
      "end": 704.915,
      "type": "line",
      "text": "and the first shall be last.",
      "verse": "13:42",
      "lineIndex": 211
    }
  ]
}