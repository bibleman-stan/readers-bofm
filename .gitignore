__pycache__/
*.pyc

# Python virtualenv (NLP parsers, etc.)
.venv/

# Audio zip bundles (too large for GitHub; individual MP3s are fine)
audio/*.zip

# Obsidian vault. Tracked: the config that makes the vault reproducible —
# app.json (incl. the ignore filters that keep data/ and books/ out of the
# index), appearance.json, community-plugins.json, hotkeys.json. Ignored: view
# state that churns every session, and third-party code re-installable from
# community-plugins.json. Note the directory itself is NOT excluded — git cannot
# re-include a file whose parent directory is.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/graph.json
.obsidian/cache/
.obsidian/plugins/
.obsidian/themes/
.trash/
Welcome.md

# Audio line cache (local only, ~100s of small MP3 fragments)
.audio-cache/

# ElevenLabs API key
.env

# Claude Code local config (per-repo permissions, not project content).
# Contents ignored, but NOT the directory itself — git cannot re-include a file
# whose parent directory is excluded, and skills below must stay tracked.
.claude/*

# Research / pre-publication (local only)
research/

# Private strategy / pre-publication (local only). Notably private/substrate/
# (2.5 GB of licensed corpora) and private/04-sources/ — neither may ever be
# committed.
#
# The method canon used to live at private/01-method/ and was re-included here
# by exception. On 2026-08-07 it moved OUT to 1-method/ at the repo root, so the
# exception is gone and this rule is a plain exclusion again. Publishing Stan's
# own method canon is fine; third-party licensed material is not.
# Private material stays local. The README stub is the exception and IS
# tracked, so the folder's purpose and layout survive even though its
# contents cannot. A bare `private/` cannot be negated into -- git will not
# descend into an ignored directory -- so the contents are ignored instead.
/private/*
!/private/README.md

# Reference/source text files (local only — not our editorial work)
data/text-files/parry/
data/text-files/v0-bofm-original/
data/text-files/v1-skousen-breaks/

# Applier transaction logs (local only — rollback artefacts)
5-machinery/validators/.tx/*.json

# Scratch / debug artefacts at repo root (detector output redirects, pickle dumps)
/*.pkl
/*_full.txt
/c:*

# Proprietary indexes (local only — not needed at runtime)
data/parry_index.json
data/hardy_intertext.json
data/hardy_phrase_index.json
data/kjv_diff_index.json
data/parallel_index.json
data/pericope_index.json
data/text-files/lds-scriptures.txt

# Text-Fabric compiled binary cache (regenerated on load)
data/tf/**/.tf/

# Stanza-parse audit outputs + spray candidate sets (regenerable from 5-machinery/scripts/audit_*.py)
data/parses/audit/

# Generated v2-spray workflow scripts (regenerable from build_spray_workflow.py)
5-machinery/scripts/workflows/

# Pre-revert scratch backup
data/text-files/v2-adjudicated/overrides.json.bak

# Skills are shareable project knowledge, not local state — track them.
# (Everything else under .claude/ stays ignored: settings, local caches.)
!.claude/skills/
!.claude/skills/**

# Parry parallelism index — DERIVED from data/text-files/parry/ (already ignored).
# Untracked 2026-08-06: it reproduces Donald Parry's published line arrangement,
# labels and indents (Deseret Book / Maxwell Institute) in machine-readable form,
# and this repo is public. Regenerate locally with 5-machinery/scripts/build_parry_index_v2.py.
data/parry_index.json
